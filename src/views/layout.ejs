
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> · <%= appName %></title>
    <script src="/theme.js?v=1"></script>
    <!-- Application stylesheets -->
    <link rel="stylesheet" href="/styles.css?v=19">
    <link rel="stylesheet" href="/inventory.css?v=43">
    <link rel="stylesheet" href="/masters.css?v=2">
    <link rel="stylesheet" href="/theme.css?v=9">
</head>
<body>
    <% if (user) { %>
        <!-- Main layout for logged-in users -->
        <div class="app-layout">
            <%- include('partials/nav') %>
            <main class="shell<%= path.startsWith('/users') ? ' team-shell' : path.startsWith('/master/') ? ' master-shell' : (path === '/inventory/new' || /^\/inventory\/\d+\/edit$/.test(path)) ? ' inventory-form-shell' : '' %>">
    <% } else { %>
        <!-- Layout for login and other public pages -->
        <%- include('partials/theme-toggle', { themeToggleClass: 'auth-theme-toggle' }) %>
        <main class="auth-shell">
    <% } %>

        <!-- Display flash messages except on user management pages -->
        <% if (flash && !flash.toast && !path.startsWith('/users')) { %>
            <div class="flash <%= flash.type %>"></div>
        <% } %>

        <!-- Render the current page content -->
        <%- body %>
        </main>

    <% if (user) { %>
        </div>
    <% } %>
</body>
</html>