<div class="page-head">
  <div><div class="eyebrow">PURCHASE ORDER</div><h1><%= order.po_number %></h1><p class="muted">Ordered <%= order.order_date %> · Vendor: <%= order.vendor_name %></p></div>
  <div class="po-page-actions">
    <a class="secondary button" href="/purchase-orders">History</a>
    <a class="secondary button" href="/purchase-orders/<%= order.id %>/edit">Edit</a>
    <a class="primary button" href="/purchase-orders/<%= order.id %>/print" target="_blank" rel="noopener">Print</a>
  </div>
</div>
<section class="card po-detail-card">
  <div class="po-detail-grid">
    <div class="po-detail-block">
      <span class="eyebrow">VENDOR</span>
      <strong class="po-vendor-name"><%= order.vendor_name %></strong>
      <span class="po-detail-value"><%= order.vendor_contact_number %></span>
      <span class="po-detail-value"><%= order.vendor_address %></span>
      <% if(order.vendor_email){ %><span class="po-detail-value"><%= order.vendor_email %></span><% } %>
    </div>
    <div class="po-detail-block">
      <span class="eyebrow">ORDER DETAILS</span>
      <strong class="po-order-number"><%= order.po_number %></strong>
      <dl class="po-order-metadata">
        <div><dt>Order date</dt><dd><%= order.order_date %></dd></div>
        <div><dt>Last updated</dt><dd><%= order.updated_at %></dd></div>
      </dl>
    </div>
  </div>
  <div class="po-detail-section-heading"><h2>Products</h2><span><%= order.items.length %> <%= order.items.length===1?'item':'items' %></span></div>
  <div class="po-product-table-wrap">
    <table class="po-product-table">
      <thead><tr><th>S.No.</th><th>Product</th><th>Description / specification</th><th>Quantity</th><th>Unit</th><th>Rate</th><th>Amount</th></tr></thead>
      <tbody><% order.items.forEach(item=>{ %><tr><td><%= item.serial_number %></td><td><strong><%= item.product_name %></strong></td><td><%= item.description||'—' %></td><td><%= Number(item.quantity).toLocaleString('en-IN') %></td><td><%= item.unit %></td><td>₹<%= Number(item.rate).toFixed(2) %></td><td>₹<%= Number(item.amount).toFixed(2) %></td></tr><% }) %></tbody>
      <tfoot><tr><th colspan="6">Total order amount</th><th>₹<%= Number(order.total_amount).toFixed(2) %></th></tr></tfoot>
    </table>
  </div>
  <div class="po-detail-payment">
    <div class="po-payment-summary"><span>Total order amount</span><strong>₹<%= Number(order.total_amount).toFixed(2) %></strong></div>
    <div class="po-payment-summary"><span>Advance · <%= Number(order.advance_percent).toFixed(2) %>%</span><strong>₹<%= Number(order.advance_amount).toFixed(2) %></strong></div>
    <div class="po-payment-summary"><span>Remaining · <%= (100-Number(order.advance_percent)).toFixed(2) %>%</span><strong>₹<%= Number(order.remaining_amount).toFixed(2) %></strong></div>
  </div>
  <% if(order.payment_conditions){ %><div class="po-detail-note"><strong>Payment conditions</strong><p><%= order.payment_conditions %></p></div><% } %>
  <% if(order.notes){ %><div class="po-detail-note"><strong>Additional notes</strong><p><%= order.notes %></p></div><% } %>
</section>
<section class="card po-audit-card">
  <div class="card-head"><div><div class="eyebrow">AUDIT TRAIL</div><h2>Order history</h2></div><span class="muted"><%= history.length %> <%= history.length===1?'change':'changes' %></span></div>
  <table><thead><tr><th>Action</th><th>Changed by</th><th>Date</th><th>Saved snapshot</th></tr></thead><tbody>
    <% if(!history.length){ %><tr><td colspan="4" class="empty">No change history.</td></tr><% } %>
    <% history.forEach(entry=>{ %><tr><td><span class="tag"><%= entry.action %></span></td><td><%= entry.actor_name %></td><td><%= entry.created_at %></td><td>
      <details class="po-history-snapshot"><summary>View details</summary>
        <p><strong><%= entry.snapshot.vendor_name %></strong> · <%= entry.snapshot.order_date %></p>
        <p>Total: ₹<%= Number(entry.snapshot.total_amount).toFixed(2) %> · Advance: <%= Number(entry.snapshot.advance_percent).toFixed(2) %>% (₹<%= Number(entry.snapshot.advance_amount).toFixed(2) %>) · Remaining: ₹<%= Number(entry.snapshot.remaining_amount).toFixed(2) %></p>
        <table><thead><tr><th>Product</th><th>Quantity</th><th>Rate</th><th>Amount</th></tr></thead><tbody>
          <% entry.snapshot.items.forEach(item=>{ %><tr><td><%= item.product_name %></td><td><%= item.quantity %> <%= item.unit %></td><td>₹<%= Number(item.rate).toFixed(2) %></td><td>₹<%= Number(item.amount).toFixed(2) %></td></tr><% }) %>
        </tbody></table>
      </details>
    </td></tr><% }) %>
  </tbody></table>
</section>
