<div class="page-head">
  <div><div class="eyebrow">PROCUREMENT</div><h1><%= title %></h1><% if(record.po_number){ %><p class="muted">PO number <strong><%= record.po_number %></strong> · edits are recorded in order history.</p><% }else{ %><p class="muted">Select a vendor and add the requested products.</p><% } %></div>
  <a class="secondary button" href="/purchase-orders">Back to purchase orders</a>
</div>
<% if(formError){ %><div class="flash error" role="alert"><%= formError %></div><% } %>
<form method="post" action="<%= action %>" class="po-form" id="purchase_order_form">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <section class="card po-form-section">
    <div class="po-form-meta">
      <label>Order date *<input type="date" name="order_date" required value="<%= record.order_date||'' %>" aria-invalid="<%= Boolean(errors.order_date) %>"><% if(errors.order_date){ %><span class="field-error"><%= errors.order_date %></span><% } %></label>
      <label>Vendor *
        <input id="vendor_search" type="search" list="vendor_choices" autocomplete="off" placeholder="Search registered vendors…" value="<%= vendors.find(vendor=>Number(vendor.id)===Number(record.vendor_id))?.name||record.vendor_name||'' %>" required>
        <datalist id="vendor_choices"><% vendors.forEach(vendor=>{ %><option value="<%= vendor.name %>"></option><% }) %></datalist>
        <input type="hidden" name="vendor_id" id="vendor_id" value="<%= record.vendor_id||'' %>">
        <span class="po-vendor-preview muted" id="vendor_preview"></span>
        <% if(errors.vendor_id){ %><span class="field-error"><%= errors.vendor_id %></span><% } %>
      </label>
    </div>
  </section>
  <section class="card po-form-section">
    <div class="po-section-heading"><h2>Products</h2><button class="secondary" type="button" id="add_product_row">Add product</button></div>
    <% if(errors.items){ %><p class="field-error"><%= errors.items %></p><% } %>
    <% Object.keys(errors).filter(key=>key.startsWith('product_')).forEach(key=>{ %><p class="field-error"><%= errors[key] %></p><% }) %>
    <div class="po-product-table-wrap">
      <table class="po-product-table">
        <thead><tr><th>S.No.</th><th>Product name *</th><th>Description / specification</th><th>Quantity *</th><th>Unit *</th><th>Rate (₹) *</th><th>Amount (₹)</th><th></th></tr></thead>
        <tbody id="po_items">
          <% items.forEach((item,index)=>{ %>
            <tr class="po-product-row">
              <td class="po-row-number"><%= index+1 %></td>
              <td><input name="product_name" maxlength="200" value="<%= item.product_name||'' %>" aria-label="Product name" role="combobox" aria-autocomplete="list" aria-haspopup="listbox" aria-expanded="false" aria-controls="po_chemical_suggestions" autocomplete="off" data-po-chemical-input required></td>
              <td><input name="description" maxlength="1000" value="<%= item.description||'' %>" aria-label="Description or specification"></td>
              <td><input name="quantity" type="number" step="0.001" min="0.001" value="<%= item.quantity||'' %>" aria-label="Quantity" required></td>
              <td><input name="unit" list="po_units" maxlength="30" value="<%= item.unit||'' %>" aria-label="Unit" required></td>
              <td><input name="rate" type="number" step="0.01" min="0" value="<%= item.rate??'' %>" aria-label="Rate in rupees" required></td>
              <td class="po-line-amount">₹0.00</td>
              <td><button class="link danger remove-po-row" type="button" aria-label="Remove product row">Remove</button></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <datalist id="po_units"><% ['Piece','Kg','Gram','Liter','ml','Box','Bottle','Pack','Set','Pair','Carton'].forEach(unit=>{ %><option value="<%= unit %>"></option><% }) %></datalist>
    <div class="po-total"><span>Total order amount</span><strong id="po_total">₹0.00</strong></div>
  </section>
  <div class="po-chemical-suggestions" id="po_chemical_suggestions" role="listbox" aria-label="Registered chemicals" hidden></div>
  <section class="card po-form-section">
    <div class="po-section-heading"><h2>Payment terms</h2></div>
    <div class="po-payment-grid">
      <label>Advance payment
        <select name="payment_mode" id="payment_mode">
          <option value="none" <%= record.payment_mode==='none'?'selected':'' %>>No advance · 0%</option>
          <option value="full" <%= record.payment_mode==='full'?'selected':'' %>>Full advance · 100%</option>
          <option value="custom" <%= record.payment_mode==='custom'?'selected':'' %>>Custom percentage</option>
        </select>
      </label>
      <label id="custom_advance_field">Custom advance percentage
        <div class="po-percent-input"><input type="number" name="advance_percent" id="advance_percent" min="0" max="100" step="0.01" value="<%= record.advance_percent??0 %>"><span>%</span></div>
        <% if(errors.advance_percent){ %><span class="field-error"><%= errors.advance_percent %></span><% } %>
      </label>
      <div class="po-payment-value"><span>Advance payment</span><strong id="advance_amount">₹0.00</strong></div>
      <div class="po-payment-value"><span>Remaining payment</span><strong id="remaining_amount">₹0.00</strong></div>
    </div>
    <label>Payment conditions / remarks<textarea name="payment_conditions" rows="2" maxlength="1000"><%= record.payment_conditions||'' %></textarea><% if(errors.payment_conditions){ %><span class="field-error"><%= errors.payment_conditions %></span><% } %></label>
    <label class="po-notes-field">Additional notes<textarea name="notes" rows="2" maxlength="2000"><%= record.notes||'' %></textarea><% if(errors.notes){ %><span class="field-error"><%= errors.notes %></span><% } %></label>
  </section>
  <div class="form-actions po-submit-actions"><button class="primary">Save purchase order</button><a class="secondary button" href="/purchase-orders">Cancel</a></div>
</form>
<template id="po_row_template">
  <tr class="po-product-row">
    <td class="po-row-number"></td>
    <td><input name="product_name" maxlength="200" aria-label="Product name" role="combobox" aria-autocomplete="list" aria-haspopup="listbox" aria-expanded="false" aria-controls="po_chemical_suggestions" autocomplete="off" data-po-chemical-input required></td>
    <td><input name="description" maxlength="1000" aria-label="Description or specification"></td>
    <td><input name="quantity" type="number" step="0.001" min="0.001" aria-label="Quantity" required></td>
    <td><input name="unit" list="po_units" maxlength="30" aria-label="Unit" required></td>
    <td><input name="rate" type="number" step="0.01" min="0" aria-label="Rate in rupees" required></td>
    <td class="po-line-amount">₹0.00</td>
    <td><button class="link danger remove-po-row" type="button" aria-label="Remove product row">Remove</button></td>
  </tr>
</template>
<script>
  const vendors = <%- JSON.stringify(vendors.map(vendor=>({id:vendor.id,name:vendor.name,contact:vendor.contact_number,address:vendor.address,email:vendor.email}))).replace(/</g,'\\u003c') %>;
  const chemicalNames = <%- JSON.stringify(chemicals.map(chemical=>chemical.name)).replace(/</g,'\\u003c') %>;
  const vendorInput = document.getElementById('vendor_search');
  const vendorIdInput = document.getElementById('vendor_id');
  const vendorPreview = document.getElementById('vendor_preview');
  const itemsBody = document.getElementById('po_items');
  const chemicalSuggestions = document.getElementById('po_chemical_suggestions');
  const currency = amount => `₹${amount.toLocaleString('en-IN',{minimumFractionDigits:2,maximumFractionDigits:2})}`;
  let activeChemicalInput = null;
  let activeChemicalIndex = -1;

  function closeChemicalSuggestions() {
    if (activeChemicalInput) {
      activeChemicalInput.setAttribute('aria-expanded', 'false');
      activeChemicalInput.removeAttribute('aria-activedescendant');
    }
    chemicalSuggestions.hidden = true;
    chemicalSuggestions.replaceChildren();
    activeChemicalInput = null;
    activeChemicalIndex = -1;
  }

  function showChemicalSuggestions(input) {
    activeChemicalInput = input;
    const query = input.value.trim().toLocaleLowerCase();
    const matches = chemicalNames.filter(name => name.toLocaleLowerCase().startsWith(query));
    chemicalSuggestions.replaceChildren();
    matches.forEach((name, index) => {
      const option = document.createElement('button');
      option.type = 'button';
      option.className = 'po-chemical-suggestion';
      option.id = `po-chemical-option-${index}`;
      option.setAttribute('role', 'option');
      option.setAttribute('aria-selected', 'false');
      option.textContent = name;
      chemicalSuggestions.append(option);
    });
    if (!matches.length) {
      const empty = document.createElement('div');
      empty.className = 'po-chemical-suggestion-empty';
      empty.textContent = 'No matching chemicals.';
      chemicalSuggestions.append(empty);
    }
    const bounds = input.getBoundingClientRect();
    chemicalSuggestions.style.left = `${bounds.left}px`;
    chemicalSuggestions.style.top = `${bounds.bottom + 4}px`;
    chemicalSuggestions.style.width = `${bounds.width}px`;
    chemicalSuggestions.hidden = false;
    input.setAttribute('aria-expanded', 'true');
    input.removeAttribute('aria-activedescendant');
    activeChemicalIndex = -1;
  }

  itemsBody.addEventListener('focusin', event => {
    if (event.target.matches('[data-po-chemical-input]')) showChemicalSuggestions(event.target);
  });
  itemsBody.addEventListener('input', event => {
    if (event.target.matches('[data-po-chemical-input]')) showChemicalSuggestions(event.target);
  });
  itemsBody.addEventListener('keydown', event => {
    if (event.target !== activeChemicalInput) return;
    const options = Array.from(chemicalSuggestions.querySelectorAll('[role="option"]'));
    if (event.key === 'Escape') {
      closeChemicalSuggestions();
    } else if ((event.key === 'ArrowDown' || event.key === 'ArrowUp') && options.length) {
      event.preventDefault();
      const direction = event.key === 'ArrowDown' ? 1 : -1;
      activeChemicalIndex = activeChemicalIndex < 0
        ? (direction > 0 ? 0 : options.length - 1)
        : (activeChemicalIndex + direction + options.length) % options.length;
      options.forEach((option, index) => option.setAttribute('aria-selected', String(index === activeChemicalIndex)));
      event.target.setAttribute('aria-activedescendant', options[activeChemicalIndex].id);
      options[activeChemicalIndex].scrollIntoView({ block: 'nearest' });
    } else if (event.key === 'Enter' && !chemicalSuggestions.hidden && activeChemicalIndex >= 0) {
      event.preventDefault();
      activeChemicalInput.value = options[activeChemicalIndex].textContent;
      closeChemicalSuggestions();
    }
  });
  chemicalSuggestions.addEventListener('mousedown', event => {
    const option = event.target.closest('[role="option"]');
    if (!option || !activeChemicalInput) return;
    event.preventDefault();
    activeChemicalInput.value = option.textContent;
    activeChemicalInput.focus();
    closeChemicalSuggestions();
  });
  document.addEventListener('pointerdown', event => {
    if (activeChemicalInput && !activeChemicalInput.contains(event.target) && !chemicalSuggestions.contains(event.target)) {
      closeChemicalSuggestions();
    }
  });
  window.addEventListener('resize', () => {
    if (activeChemicalInput) showChemicalSuggestions(activeChemicalInput);
  });
  window.addEventListener('scroll', () => {
    if (activeChemicalInput) showChemicalSuggestions(activeChemicalInput);
  }, true);

  function syncVendor() {
    const vendor = vendors.find(option => option.name.toLocaleLowerCase() === vendorInput.value.trim().toLocaleLowerCase());
    vendorIdInput.value = vendor ? vendor.id : '';
    vendorPreview.textContent = vendor
      ? [vendor.address, vendor.contact, vendor.email].filter(Boolean).join(' · ')
      : (vendorInput.value ? 'Select a registered vendor from the suggestions.' : '');
  }

  function updateOrderTotals() {
    let total = 0;
    Array.from(itemsBody.querySelectorAll('.po-product-row')).forEach((row,index) => {
      row.querySelector('.po-row-number').textContent = index + 1;
      const quantity = Number(row.querySelector('[name="quantity"]').value) || 0;
      const rate = Number(row.querySelector('[name="rate"]').value) || 0;
      const amount = Math.round(quantity * rate * 100) / 100;
      total += amount;
      row.querySelector('.po-line-amount').textContent = currency(amount);
    });
    total = Math.round(total * 100) / 100;
    const mode = document.getElementById('payment_mode').value;
    const customField = document.getElementById('custom_advance_field');
    const percentInput = document.getElementById('advance_percent');
    const percentage = mode === 'none' ? 0 : mode === 'full' ? 100 : Number(percentInput.value) || 0;
    customField.hidden = mode !== 'custom';
    percentInput.required = mode === 'custom';
    percentInput.disabled = mode !== 'custom';
    const advance = Math.round(total * percentage) / 100;
    document.getElementById('po_total').textContent = currency(total);
    document.getElementById('advance_amount').textContent = `${currency(advance)} (${percentage.toFixed(2)}%)`;
    document.getElementById('remaining_amount').textContent = `${currency(Math.max(0,total-advance))} (${(100-percentage).toFixed(2)}%)`;
  }

  vendorInput.addEventListener('input', syncVendor);
  vendorInput.addEventListener('change', syncVendor);
  itemsBody.addEventListener('input', updateOrderTotals);
  itemsBody.addEventListener('click', event => {
    if (!event.target.classList.contains('remove-po-row')) return;
    if (itemsBody.querySelectorAll('.po-product-row').length <= 1) {
      itemsBody.querySelector('.po-product-row input[name="product_name"]').focus();
      return;
    }
    event.target.closest('.po-product-row').remove();
    updateOrderTotals();
  });
  document.getElementById('add_product_row').addEventListener('click', () => {
    itemsBody.append(document.getElementById('po_row_template').content.cloneNode(true));
    updateOrderTotals();
    itemsBody.lastElementChild.querySelector('[name="product_name"]').focus();
  });
  document.getElementById('payment_mode').addEventListener('change', updateOrderTotals);
  document.getElementById('advance_percent').addEventListener('input', updateOrderTotals);
  document.getElementById('purchase_order_form').addEventListener('submit', event => {
    syncVendor();
    if (!vendorIdInput.value) {
      event.preventDefault();
      vendorInput.setCustomValidity('Select an existing vendor from the suggestions.');
      vendorInput.reportValidity();
      vendorInput.addEventListener('input', () => vendorInput.setCustomValidity(''), { once: true });
    }
  });
  syncVendor();
  updateOrderTotals();
</script>
