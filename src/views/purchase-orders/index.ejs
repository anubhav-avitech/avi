<div class="page-head">
  <div><div class="eyebrow">PROCUREMENT</div><h1>Purchase orders</h1><p class="muted">Prepare, track, and reprint vendor orders.</p></div>
  <div class="po-page-actions">
    <a class="secondary button" href="/purchase-orders/company-settings">Company details</a>
    <a class="primary button" href="/purchase-orders/new">New purchase order</a>
  </div>
</div>
<form class="toolbar po-filters" method="get" action="/purchase-orders">
  <input name="q" value="<%= query %>" placeholder="Search PO number or vendor…" aria-label="Search purchase orders">
  <label>From<input type="date" name="from" value="<%= from %>"></label>
  <label>To<input type="date" name="to" value="<%= to %>"></label>
  <button class="secondary">Filter</button>
  <% if(query||from||to){ %><a class="secondary button" href="/purchase-orders">Clear</a><% } %>
</form>
<% if(filterErrors.range){ %><p class="field-error po-filter-error"><%= filterErrors.range %></p><% } %>
<% if(filterErrors.from){ %><p class="field-error po-filter-error"><%= filterErrors.from %></p><% } %>
<% if(filterErrors.to){ %><p class="field-error po-filter-error"><%= filterErrors.to %></p><% } %>
<section class="card po-history-card">
  <table class="po-history-table">
    <thead><tr><th>PO number</th><th>Order date</th><th>Vendor</th><th>Total</th><th>Advance</th><th>Remaining</th><th>Last updated</th><th></th></tr></thead>
    <tbody>
      <% if(!rows.length){ %><tr><td colspan="8" class="empty"><%= query||from||to?'No purchase orders match these filters.':'No purchase orders have been created yet.' %></td></tr><% } %>
      <% rows.forEach(order=>{ %>
        <tr>
          <td><strong><%= order.po_number %></strong></td>
          <td><%= order.order_date %></td>
          <td><%= order.vendor_name %></td>
          <td>₹<%= Number(order.total_amount).toFixed(2) %></td>
          <td>₹<%= Number(order.advance_amount).toFixed(2) %> <small>(<%= Number(order.advance_percent).toFixed(2) %>%)</small></td>
          <td>₹<%= Number(order.remaining_amount).toFixed(2) %></td>
          <td><%= order.updated_at %></td>
          <td class="actions">
            <a href="/purchase-orders/<%= order.id %>">View</a>
            <a href="/purchase-orders/<%= order.id %>/edit">Edit</a>
            <a href="/purchase-orders/<%= order.id %>/print" target="_blank" rel="noopener">Print</a>
            <form method="post" action="/purchase-orders/<%= order.id %>/delete" onsubmit="return confirm('Delete <%= order.po_number %>? Its change history will be retained.');">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="link danger">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</section>
