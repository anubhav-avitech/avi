<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Purchase Order <%= order.po_number %></title>
  <style>
    *{box-sizing:border-box}
    body{margin:0;background:#f0f1f3;color:#111;font:10px/1.35 Arial,Helvetica,sans-serif}
    .print-toolbar{display:flex;justify-content:center;gap:8px;padding:12px}
    .print-toolbar a,.print-toolbar button{padding:8px 14px;border:1px solid #cbd0d7;border-radius:4px;background:#fff;color:#20242a;font:inherit;text-decoration:none;cursor:pointer}
    .print-sheet{display:flex;flex-direction:column;width:210mm;min-height:297mm;margin:0 auto 20px;padding:13mm 15mm 11mm;background:#fff}
    .po-header{position:relative;display:flex;min-height:32mm;align-items:flex-start;justify-content:center;text-align:center}
    .po-logo{position:absolute;top:0;left:0;max-width:56mm;max-height:19mm;object-fit:contain}
    .po-company{max-width:125mm;padding:1mm 0 0}
    .po-company h1{margin:0 0 2mm;font-size:14px;font-weight:700;letter-spacing:.025em}
    .po-company p{margin:.5mm 0;font-size:9px}
    .po-title-row{margin:0 0 4mm;text-align:center}
    .po-title-row .po-company{max-width:none;padding:0}
    .po-title-row .po-company h1{margin:0 0 1mm;font-size:14px}
    .po-title-row .po-company p{margin:0;font-size:9px}
    .po-title-row h2{margin:7mm 0 1.5mm;font-size:11px;text-decoration:underline;text-underline-offset:2px}
    .po-number{display:flex;justify-content:center;gap:12mm;font-size:9px}
    .po-parties{margin:0 0 5mm}
    .po-party h3{margin:0 0 1mm;font-size:9px;font-weight:400}
    .po-party strong{display:block;margin-bottom:.5mm;font-size:10px;text-transform:uppercase}
    .po-party p{margin:.5mm 0;white-space:pre-line}
    .po-order-details{margin:0 0 2mm;text-align:center;font-size:10px;font-weight:700;text-decoration:underline;text-underline-offset:2px}
    .po-lines{width:100%;border-collapse:collapse;table-layout:fixed}
    .po-lines th,.po-lines td{padding:1.4mm 1.8mm;border:1px solid #666;text-align:left;vertical-align:top;overflow-wrap:anywhere}
    .po-lines th{font-size:9px;font-weight:700}
    .po-lines .center{text-align:center}
    .po-lines .number{text-align:right;white-space:nowrap}
    .po-lines tfoot th{text-align:right}
    .po-description strong{display:block;font-weight:400}
    .po-description span{display:block;margin-top:.5mm}
    .po-payment{margin-top:2mm}
    .po-payment p{margin:0}
    .po-conditions{margin-top:1mm}
    .po-conditions h3{display:inline;margin:0;font-size:10px;font-weight:400}
    .po-conditions p{display:inline;margin:0 0 0 1mm;white-space:pre-wrap}
    .po-signatures{margin:9mm 0 0 auto;width:45mm;text-align:center;font-size:8px}
    .po-signatures p{margin:0}
    .po-signature-space{height:15mm}
    .po-footer{margin-top:auto;padding-top:12mm;text-align:center;font-size:8px}
    @page{size:A4;margin:0}
    @media print{body{background:#fff}.print-toolbar{display:none}.print-sheet{width:210mm;min-height:297mm;margin:0;padding:13mm 15mm 11mm;box-shadow:none}.po-lines thead{display:table-header-group}.po-lines tr{break-inside:avoid}.po-payment,.po-conditions,.po-signatures{break-inside:avoid}}
    @media screen{.print-sheet{box-shadow:0 2px 18px rgba(0,0,0,.12)}}
  </style>
</head>
<body>
  <div class="print-toolbar"><a href="/purchase-orders/<%= order.id %>">Back to order</a><button type="button" onclick="window.print()">Print purchase order</button></div>
  <main class="print-sheet">
    <header class="po-header">
      <img class="po-logo" src="<%= order.company_logo_path %>" alt="<%= order.company_name %>">
    </header>
    <div class="po-title-row">
      <div class="po-company">
        <h1><%= order.company_name %></h1>
        <% if(order.company_address){ %><p><%= order.company_address %></p><% } %>
        <% if(order.company_contact_number){ %><p>Phone: <%= order.company_contact_number %><% if(order.company_email){ %> · E-mail: <%= order.company_email %><% } %></p><% }else if(order.company_email){ %><p>E-mail: <%= order.company_email %></p><% } %>
        <% if(order.company_tax_registration_number){ %><p>GST NO. <%= order.company_tax_registration_number %></p><% } %>
      </div>
      <h2>PURCHASE/WORK ORDER</h2>
      <div class="po-number"><span>Purchase Order No: <strong><%= order.po_number %></strong></span><span>Date: <%= order.order_date %></span></div>
    </div>
    <section class="po-parties">
      <div class="po-party"><h3>TO:</h3><strong><%= order.vendor_name %></strong><p><%= order.vendor_address %></p><p><%= order.vendor_contact_number %></p><% if(order.vendor_email){ %><p><%= order.vendor_email %></p><% } %></div>
    </section>
    <h3 class="po-order-details">ORDER DETAILS</h3>
    <table class="po-lines">
      <colgroup><col style="width:12%"><col style="width:68%"><col style="width:20%"></colgroup>
      <thead><tr><th class="center">S.No.</th><th>Description</th><th class="number">Amount (INR)</th></tr></thead>
      <tbody><% order.items.forEach(item=>{ %><tr><td class="center"><%= item.serial_number %></td><td class="po-description"><strong><%= item.product_name %></strong><% if(item.description){ %><span><%= item.description %></span><% } %><span>Qty- <%= Number(item.quantity).toLocaleString('en-IN') %> <%= item.unit %>, @ INR <%= Number(item.rate).toFixed(2) %> per 1 <%= item.unit %></span></td><td class="number"><%= Number(item.amount).toFixed(2) %></td></tr><% }) %></tbody>
      <tfoot><tr><th colspan="2">Total Amount (INR)</th><th class="number"><%= Number(order.total_amount).toFixed(2) %></th></tr></tfoot>
    </table>
    <section class="po-payment">
      <p>Payment Terms:</p>
      <p><%= Number(order.advance_percent).toFixed(2) %>% Advance Payment: INR <%= Number(order.advance_amount).toFixed(2) %></p>
      <p>Remaining Payment (<%= (100-Number(order.advance_percent)).toFixed(2) %>%): INR <%= Number(order.remaining_amount).toFixed(2) %></p>
    </section>
    <% if(order.payment_conditions||order.notes){ %><section class="po-conditions"><h3>Remarks/Notes:</h3><% if(order.payment_conditions){ %><p><%= order.payment_conditions %></p><% } %><% if(order.notes){ %><p><%= order.notes %></p><% } %></section><% }else{ %><section class="po-conditions"><h3>Remarks/Notes:</h3></section><% } %>
    <section class="po-signatures"><p>for <%= order.company_name %></p><div class="po-signature-space"></div><p>Authorised Signatory</p></section>
    <footer class="po-footer"><%= order.company_jurisdiction ? `SUBJECT TO ${order.company_jurisdiction.toUpperCase()}` : '' %></footer>
  </main>
</body>
</html>
