
<div class="page-head">
    <div>
        <div class="eyebrow">PEOPLE</div>
        <h1><%= person ? 'Edit user' : 'Add user' %></h1>
        <p class="muted">Only administrators can create or change accounts.</p>
    </div>
    <a class="secondary button" href="/users">Back</a>
</div>

<!-- User form for creating or editing an account -->
<section class="card form-card team-form-card team-page">
    <form method="post"
          action="<%= person ? '/users/' + person.id + '/edit' : '/users/new' %>"
          class="grid-form"
          autocomplete="off">

        <!-- CSRF token for form security -->
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <!-- Employee information -->
        <label>
            Employee code *
            <input name="employee_code" required value="<%= person?.employee_code || '' %>">
        </label>

        <label>
            Name *
            <input name="name" required value="<%= person?.name || '' %>">
        </label>

        <label>
            Email *
            <input type="email" name="email" required autocomplete="off" value="<%= person?.email || '' %>">
        </label>

        <!-- Password is required for new users but optional when editing -->
        <label>
            Password
            <input type="password" name="password" autocomplete="new-password" <%= person ? 'placeholder="Leave blank to keep current"' : 'required' %>>
        </label>

        <!-- Allow administrators to activate or deactivate existing users -->
        <% if (person) { %>
            <label>
                Status
                <select name="status">
                    <option value="ACTIVE" <%= person.status === 'ACTIVE' ? 'selected' : '' %>>Active</option>
                    <option value="INACTIVE" <%= person.status === 'INACTIVE' ? 'selected' : '' %>>Inactive</option>
                </select>
            </label>

            <% if (person.role_name !== 'Administrator') { %>
                <fieldset class="span-2">
                    <legend>Master page access</legend>
                    <div class="master-permission-grid">
                        <label><input type="checkbox" name="master_permissions" value="CHEMICAL_MASTER_ACCESS" <%= person.permissions.includes('CHEMICAL_MASTER_ACCESS') ? 'checked' : '' %>> Chemical master</label>
                        <label><input type="checkbox" name="master_permissions" value="VENDOR_MASTER_ACCESS" <%= person.permissions.includes('VENDOR_MASTER_ACCESS') ? 'checked' : '' %>> Vendor master</label>
                        <label><input type="checkbox" name="master_permissions" value="GLASSWARE_MASTER_ACCESS" <%= person.permissions.includes('GLASSWARE_MASTER_ACCESS') ? 'checked' : '' %>> Glassware master</label>
                        <label><input type="checkbox" name="master_permissions" value="EQUIPMENT_MASTER_ACCESS" <%= person.permissions.includes('EQUIPMENT_MASTER_ACCESS') ? 'checked' : '' %>> Equipment &amp; instruments master</label>
                    </div>
                </fieldset>
            <% } %>
        <% } %>

        <!-- Save changes or return to the user list -->
        <div class="span-2 form-actions">
            <button class="primary">Save user</button>
            <a class="secondary button" href="/users">Cancel</a>
        </div>
    </form>
</section>