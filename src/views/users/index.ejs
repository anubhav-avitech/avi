<div class="page-head"><div><div class="eyebrow">PEOPLE</div><h1>Users</h1><p class="muted">Employees available to receive inventory.</p></div><% if(user.permissions.includes('USERS_MANAGE')){ %><a class="primary button" href="/users/new">Add user</a><% } %></div><section class="card"><table><thead><tr><th>Employee</th><th>Department</th><th>Role</th><th>Status</th><th></th></tr></thead><tbody><% rows.forEach(u=>{ %><tr><td><strong><%= u.name %></strong><small><%= u.employee_code %> · <%= u.email %></small></td><td><%= u.department||'—' %></td><td><span class="tag"><%= u.role_name %></span></td><td><span class="status <%= u.status.toLowerCase() %>"><%= u.status %></span></td><td><% if(user.permissions.includes('USERS_MANAGE')){ %><a href="/users/<%= u.id %>/edit">Edit</a><% } %></td></tr><% }) %></tbody></table></section>
