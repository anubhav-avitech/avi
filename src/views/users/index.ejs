<div class="page-head"><div><div class="eyebrow">INVENTORY TEAM</div><h1>Inventory Team</h1><p class="muted">Manage team members' application accounts and roles.</p></div><% if(user.permissions.includes('USERS_MANAGE')){ %><a class="primary button" href="/users/new">Add user</a><% } %></div><section class="card"><table><thead><tr><th>Team member</th><th>Role</th><th>Status</th><th></th></tr></thead><tbody><% if(!rows.length){ %><tr><td colspan="4" class="empty">No team members found.</td></tr><% } %><% rows.forEach(u=>{ %><tr><td><strong><%= u.name %></strong><small><%= u.employee_code %> · <%= u.email %></small></td><td><span class="tag"><%= u.role_name %></span></td><td><span class="status <%= u.status.toLowerCase() %>"><%= u.status %></span></td><td class="actions"><% if(user.permissions.includes('USERS_MANAGE')){ %><a href="/users/<%= u.id %>/edit">Edit</a><% if(Number(u.id)!==Number(user.id)){ %><form method="post" action="/users/<%= u.id %>/delete" onsubmit="return confirm('Permanently delete this account? Its user links will be cleared from old history records, but the records themselves will be kept.');"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="link danger">Delete</button></form><% } %><% } %></td></tr><% }) %></tbody></table></section>
