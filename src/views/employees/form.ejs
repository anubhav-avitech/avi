<div class="page-head"><div><div class="eyebrow">PEOPLE</div><h1>Add person</h1></div><a class="secondary button" href="/assignments/new">Back</a></div>
<section class="card form-card"><form method="post" action="/employees/new" class="grid-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
