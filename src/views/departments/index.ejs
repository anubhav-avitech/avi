<div class="page-head">
  <div>
    <div class="eyebrow">LABORATORY</div>
    <h1>Department</h1>
    <p class="muted">This system is configured for one department.</p>
  </div>
</div>
<section class="card">
  <table>
    <thead><tr><th>Department</th><th>Status</th></tr></thead>
    <tbody>
      <% rows.forEach(department=>{ %>
        <tr>
          <td><strong><%= department.name %></strong></td>
          <td><span class="status <%= department.status.toLowerCase() %>"><%= department.status %></span></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</section>
