<div class="page-head">
  <div><div class="eyebrow">INVENTORY</div><h1><%= item?'Edit inventory':'Add inventory' %></h1><p class="muted">Enter stock and glassware or equipment details here. Chemicals are tracked by batch and container size.</p></div>
  <a class="secondary button" href="/inventory">Back</a>
</div>
<section class="card form-card">
  <form method="post" action="<%= action %>" class="grid-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label id="stock_name_field" <%= item?.chemical_form?'hidden':'' %>>Name *<input id="name" name="name" required maxlength="150" value="<%= item?.chemical_form?'':item?.name||'' %>" <%= item?.chemical_form||item?.glassware_master_id||item?.equipment_master_id?'readonly':'' %>></label>
    <% if(!item){ %>
      <label>Glassware master
        <select id="glassware_master_id" name="glassware_master_id">
          <option value="">Not linked to glassware</option>
          <% glassware.forEach(master=>{ %>
            <option value="<%= master.id %>" data-name="<%= master.name %>"><%= master.name %></option>
          <% }) %>
        </select>
      </label>
      <label>Equipment & instruments master
        <select id="equipment_master_id" name="equipment_master_id">
          <option value="">Not linked to equipment</option>
          <% equipment.forEach(master=>{ %>
            <option value="<%= master.id %>" data-name="<%= master.name %>"><%= master.name %></option>
          <% }) %>
        </select>
      </label>
    <% } else if(item.glassware_master_id){ %>
      <label>Glassware master<input value="<%= item.glassware_master_name %>" readonly></label>
    <% } else if(item.equipment_master_id){ %>
      <label>Equipment & instruments master<input value="<%= item.equipment_master_name %>" readonly></label>
    <% } %>
    <label>Item type
      <select id="item_type" name="item_type" <%= item?.glassware_master_id||item?.equipment_master_id?'disabled':'' %>>
        <option value="ASSET" <%= item?.item_type==='ASSET'||!item?'selected':'' %>>Asset</option>
        <option value="CONSUMABLE" <%= item?.item_type==='CONSUMABLE'?'selected':'' %>>Consumable</option>
      </select>
    </label>
    <label>Chemical type
      <select id="chemical_form" name="chemical_form" <%= item?.chemical_form?'disabled':'' %>>
        <option value="">Not a chemical</option>
        <option value="LIQUID" <%= item?.chemical_form==='LIQUID'?'selected':'' %>>Liquid</option>
        <option value="POWDER" <%= item?.chemical_form==='POWDER'?'selected':'' %>>Powder</option>
      </select>
      <% if(item?.chemical_form){ %><input type="hidden" name="chemical_form" value="<%= item.chemical_form %>"><% } %>
    </label>
    <% if(!item&&batches.length){ %>
      <label class="span-2">Reuse a saved chemical batch
        <select id="saved_batch">
          <option value="">Enter a new batch</option>
          <% batches.forEach(batch=>{ %>
            <option
              data-chemical-id="<%= batch.chemical_id %>"
              data-form="<%= batch.chemical_form %>"
              data-batch="<%= batch.batch_number %>"
              data-manufacturer="<%= batch.manufacturer||'' %>"
              data-expiry="<%= batch.expiry_date||'' %>">
              <%= batch.name %> · <%= batch.batch_number %> · <%= batch.expiry_date||'No expiry' %>
            </option>
          <% }) %>
        </select>
      </label>
    <% } %>
    <div id="chemical_fields" class="span-2 grid-form" <%= item?.chemical_form?'':'hidden' %>>
      <%- include('../partials/master-autocomplete', {
        label: 'Chemical name',
        fieldName: 'chemical_id',
        inputId: 'chemical_search',
        listId: 'chemical_options',
        options: chemicals,
        selectedId: item?.chemical_master_id,
        selectedName: item?.chemical_master_name,
        required: Boolean(item?.chemical_form)
      }) %>
      <label>Container capacity *
        <input type="number" step="0.001" min="0.001" name="container_capacity" value="<%= item?.container_capacity||'' %>">
      </label>
      <label>Capacity unit *
        <select name="container_unit">
          <% ['ml','L','g','kg'].forEach(x=>{ %>
            <option value="<%= x %>" <%= (item?.container_unit||'ml')===x?'selected':'' %>><%= x %></option>
          <% }) %>
        </select>
      </label>
      <p class="span-2 muted">Each stock line represents one batch and one container size. Add another line to track a different size from the same batch.</p>
    </div>
    <div id="glassware_fields" class="span-2 grid-form" <%= item?.glassware_master_id?'':'hidden' %>>
      <label>Glassware type *<input name="glassware_type" maxlength="100" data-master-required value="<%= item?.glassware_type||'' %>"></label>
      <label>Capacity *<input type="number" step="0.001" min="0.001" max="999999999.999" name="capacity" data-master-required value="<%= item?.capacity||'' %>"></label>
      <label>Capacity unit *
        <select name="capacity_unit" data-master-required>
          <% ['ml','L','µl'].forEach(x=>{ %><option value="<%= x %>" <%= (item?.capacity_unit||'ml')===x?'selected':'' %>><%= x %></option><% }) %>
        </select>
      </label>
      <label>Material *<input name="material" maxlength="100" data-master-required value="<%= item?.material||'' %>"></label>
      <label>Class *
        <select name="glass_class" data-master-required>
          <% [['CLASS_A','Class A'],['CLASS_B','Class B'],['NOT_APPLICABLE','Not Applicable']].forEach(([value,label])=>{ %><option value="<%= value %>" <%= (item?.glass_class||'NOT_APPLICABLE')===value?'selected':'' %>><%= label %></option><% }) %>
        </select>
      </label>
      <label>Graduation *
        <select name="graduation" data-master-required>
          <% [['GRADUATED','Graduated'],['NON_GRADUATED','Non-graduated']].forEach(([value,label])=>{ %><option value="<%= value %>" <%= (item?.graduation||'NON_GRADUATED')===value?'selected':'' %>><%= label %></option><% }) %>
        </select>
      </label>
    </div>
    <div id="equipment_fields" class="span-2 grid-form" <%= item?.equipment_master_id?'':'hidden' %>>
      <label>Equipment type *<input name="equipment_type" maxlength="100" data-master-required value="<%= item?.equipment_type||'' %>"></label>
      <label>Model number<input name="model_number" maxlength="100" value="<%= item?.model_number||'' %>"></label>
      <label class="span-2">Technical specifications<textarea name="technical_specifications" maxlength="4000" rows="3"><%= item?.technical_specifications||'' %></textarea></label>
      <label>Calibration required *
        <select id="calibration_required" name="calibration_required" data-master-required>
          <option value="0" <%= String(item?.calibration_required??0)==='0'?'selected':'' %>>No</option>
          <option value="1" <%= String(item?.calibration_required??0)==='1'?'selected':'' %>>Yes</option>
        </select>
      </label>
      <label id="calibration_frequency_field" <%= String(item?.calibration_required||0)==='1'?'':'hidden' %>>Calibration frequency<input id="calibration_frequency" name="calibration_frequency" maxlength="100" value="<%= item?.calibration_frequency||'' %>" <%= String(item?.calibration_required||0)==='1'?'required':'' %>></label>
      <label>Warranty applicable *
        <select name="warranty_applicable" data-master-required>
          <option value="0" <%= String(item?.warranty_applicable??0)==='0'?'selected':'' %>>No</option>
          <option value="1" <%= String(item?.warranty_applicable??0)==='1'?'selected':'' %>>Yes</option>
        </select>
      </label>
    </div>
    <label>Minimum stock alert threshold<input id="minimum_stock" type="number" step="0.001" min="0" name="minimum_stock" value="<%= item?.minimum_stock??0 %>" required></label>
    <label>Qty received from vendor *<input id="quantity" type="number" step="0.001" min="0.001" name="quantity" required value="<%= item?.quantity??1 %>" <%= item?'readonly':'' %>></label>
    <label>Unit *<input id="unit" name="unit" maxlength="30" value="<%= item?.unit||'Piece' %>" required <%= item?'readonly':'' %>></label>
    <%- include('../partials/master-autocomplete', {
      label: 'Vendor name',
      fieldName: 'vendor_id',
      inputId: 'vendor_search',
      listId: 'vendor_options',
      options: vendors,
      selectedId: item?.vendor_master_id,
      selectedName: item?.vendor_master_name,
      required: false
    }) %>
    <label>Bill no.<input id="vendor_bill_no" name="vendor_bill_no" value="<%= item?.vendor_bill_no||'' %>"></label>
    <label>Make / Grade<input id="make_grade" name="make_grade" value="<%= item?.make_grade||'' %>"></label>
    <label>Received by<input id="received_by" name="received_by" value="<%= item?.received_by||'' %>"></label>
    <label>Date of receiving<input id="received_date" type="date" name="received_date" value="<%= item?.received_date||'' %>"></label>
    <label>Serial number<input name="serial_number" value="<%= item?.serial_number||'' %>"></label>
    <label>Location<input name="location" value="<%= item?.location||'' %>" placeholder="e.g. Lab Store / Rack A3"></label>
    <label>Batch number<input id="batch_number" name="batch_number" value="<%= item?.batch_number||'' %>"></label>
    <label>Mfg.<input id="manufacturer" name="manufacturer" value="<%= item?.manufacturer||'' %>"></label>
    <label>Expiry date<input id="expiry_date" type="date" name="expiry_date" value="<%= item?.expiry_date||'' %>"></label>
    <label class="span-2">Description<textarea name="description" rows="3"><%= item?.description||'' %></textarea></label>
    <div class="span-2 form-actions"><button class="primary">Save inventory</button><a class="secondary button" href="/inventory">Cancel</a></div>
  </form>
</section>
<% if(item&&user.permissions.includes('INVENTORY_UPDATE')&&item.status!=='RETIRED'){ %>
  <section class="card stock-maintenance-card">
    <div class="card-head"><div><div class="eyebrow">STOCK CONTROL</div><h2>Adjust or dispose of central stock</h2><p class="muted">Each change is recorded in the inventory transaction ledger.</p></div></div>
    <div class="stock-maintenance-grid">
      <form method="post" action="/inventory/<%= item.id %>/adjust" class="stack">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <h3>Adjust stock</h3>
        <label>Quantity change (+ or −)<input type="number" step="<%= item.chemical_form?'1':'0.001' %>" min="<%= item.chemical_form?'-'+item.quantity:'-'+item.quantity %>" name="delta" required placeholder="e.g. 2 or -1"></label>
        <label>Reason *<input name="note" maxlength="500" required></label>
        <button class="secondary">Record adjustment</button>
      </form>
      <form method="post" action="/inventory/<%= item.id %>/dispose" class="stack">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <h3>Dispose of stock</h3>
        <label>Quantity *<input type="number" step="<%= item.chemical_form?'1':'0.001' %>" min="<%= item.chemical_form?'1':'0.001' %>" max="<%= item.quantity %>" name="quantity" required></label>
        <label>Reason *<input name="note" maxlength="500" required></label>
        <button class="secondary danger">Record disposal</button>
      </form>
    </div>
  </section>
<% } %>
<script>
  const chemicalForm = document.getElementById('chemical_form');
  const chemicalFields = document.getElementById('chemical_fields');
  const itemType = document.getElementById('item_type');
  const unit = document.getElementById('unit');
  const capacityUnit = document.querySelector('[name="container_unit"]');
  const quantity = document.getElementById('quantity');
  const chemicalSearch = document.getElementById('chemical_search');
  const chemicalId = document.getElementById('chemical_id');
  const stockNameField = document.getElementById('stock_name_field');
  const stockName = document.getElementById('name');
  const glasswareMaster = document.getElementById('glassware_master_id');
  const equipmentMaster = document.getElementById('equipment_master_id');
  const glasswareFields = document.getElementById('glassware_fields');
  const equipmentFields = document.getElementById('equipment_fields');
  const fixedGlasswareMaster = <%= Boolean(item?.glassware_master_id) %>;
  const fixedEquipmentMaster = <%= Boolean(item?.equipment_master_id) %>;
  const isNewInventory = <%= item?'false':'true' %>;

  function updateCalibrationFrequencyVisibility() {
    const required = !equipmentFields.hidden && document.getElementById('calibration_required').value === '1';
    const field = document.getElementById('calibration_frequency_field');
    const input = document.getElementById('calibration_frequency');
    field.hidden = !required;
    input.required = required;
    if (!required) input.value = '';
  }

  function updateInventoryMasterFields() {
    const hasGlasswareMaster = isNewInventory ? Boolean(glasswareMaster?.value) : fixedGlasswareMaster;
    const hasEquipmentMaster = isNewInventory ? Boolean(equipmentMaster?.value) : fixedEquipmentMaster;
    glasswareFields.hidden = !hasGlasswareMaster;
    equipmentFields.hidden = !hasEquipmentMaster;
    glasswareFields.querySelectorAll('[data-master-required]').forEach(input => {
      input.required = hasGlasswareMaster;
    });
    equipmentFields.querySelectorAll('[data-master-required]').forEach(input => {
      input.required = hasEquipmentMaster;
    });
    updateCalibrationFrequencyVisibility();
  }

  document.querySelectorAll('[data-master-combobox]').forEach(combobox => {
    const input = combobox.querySelector('[data-master-input]');
    const idInput = combobox.querySelector('input[type="hidden"]');
    const list = combobox.querySelector('[role="listbox"]');
    const options = Array.from(list.querySelectorAll('[role="option"]'));
    const empty = list.querySelector('.master-autocomplete-empty');
    let activeIndex = -1;

    function showOptions() {
      list.hidden = false;
      input.setAttribute('aria-expanded', 'true');
    }

    function hideOptions() {
      list.hidden = true;
      input.setAttribute('aria-expanded', 'false');
      input.removeAttribute('aria-activedescendant');
      activeIndex = -1;
    }

    function filterOptions() {
      const query = input.value.trim().toLocaleLowerCase();
      let visible = 0;
      options.forEach(option => {
        const matches = option.dataset.name.toLocaleLowerCase().startsWith(query);
        option.hidden = !matches;
        option.setAttribute('aria-selected', 'false');
        if (matches) visible += 1;
      });
      empty.hidden = visible > 0;
      activeIndex = -1;
    }

    function selectOption(option) {
      input.value = option.dataset.name;
      idInput.value = option.dataset.value;
      input.setCustomValidity('');
      hideOptions();
      input.dispatchEvent(new Event('master-selection', { bubbles: true }));
    }

    input.addEventListener('focus', () => {
      filterOptions();
      showOptions();
    });
    input.addEventListener('input', () => {
      idInput.value = '';
      input.setCustomValidity(input.value.trim() ? 'Select an existing option from the list.' : '');
      filterOptions();
      showOptions();
    });
    input.addEventListener('keydown', event => {
      const visibleOptions = options.filter(option => !option.hidden);
      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
        event.preventDefault();
        showOptions();
        if (!visibleOptions.length) return;
        const direction = event.key === 'ArrowDown' ? 1 : -1;
        activeIndex = activeIndex < 0
          ? (direction > 0 ? 0 : visibleOptions.length - 1)
          : (activeIndex + direction + visibleOptions.length) % visibleOptions.length;
        visibleOptions.forEach((option, index) => option.setAttribute('aria-selected', String(index === activeIndex)));
        if (visibleOptions[activeIndex]) input.setAttribute('aria-activedescendant', visibleOptions[activeIndex].id);
        if (visibleOptions[activeIndex]) visibleOptions[activeIndex].scrollIntoView({ block: 'nearest' });
      } else if (event.key === 'Enter' && !list.hidden) {
        const option = visibleOptions[activeIndex];
        if (option) {
          event.preventDefault();
          selectOption(option);
        }
      } else if (event.key === 'Escape') {
        hideOptions();
      }
    });
    options.forEach(option => option.addEventListener('click', () => selectOption(option)));
    document.addEventListener('click', event => {
      if (!combobox.contains(event.target)) hideOptions();
    });
    input.addEventListener('blur', () => {
      window.setTimeout(hideOptions, 100);
    });
    input.addEventListener('master-selection', () => {
      if (input.value.trim() && !idInput.value) input.setCustomValidity('Select an existing option from the list.');
      else input.setCustomValidity('');
    });
    filterOptions();
  });

  window.selectMasterOption = (fieldName, id) => {
    const masterInput = Array.from(document.querySelectorAll('[data-master-input]'))
      .find(input => input.dataset.masterInput === fieldName);
    const combobox = masterInput?.closest('[data-master-combobox]');
    if (!combobox) return;
    const option = Array.from(combobox.querySelectorAll('[role="option"]'))
      .find(candidate => candidate.dataset.value === String(id));
    if (option) option.click();
  };

  function applyInventoryMasterChoice(select) {
    if (!isNewInventory || !select) return;
    const other = select === glasswareMaster ? equipmentMaster : glasswareMaster;
    if (select.value) {
      if (other) other.value = '';
      chemicalForm.value = '';
      updateChemicalFields(false);
      const option = select.selectedOptions[0];
      stockName.value = option.dataset.name;
      stockName.readOnly = true;
      itemType.value = 'ASSET';
      itemType.disabled = true;
    } else if (other && other.value) {
      applyInventoryMasterChoice(other);
    } else {
      stockName.readOnly = false;
      itemType.disabled = false;
    }
    updateInventoryMasterFields();
  }

  function updateChemicalFields(syncInventoryMaster = true) {
    const isChemical = Boolean(chemicalForm.value);
    chemicalFields.hidden = !isChemical;
    stockNameField.hidden = isChemical;
    stockName.disabled = isChemical;
    chemicalSearch.required = isChemical;
    if (!isChemical) {
      chemicalId.value = '';
      chemicalSearch.value = '';
      chemicalSearch.setCustomValidity('');
    }
    document.querySelector('[name="container_capacity"]').required = isChemical;
    capacityUnit.required = isChemical;
    document.getElementById('batch_number').required = isChemical;
    document.getElementById('expiry_date').required = isChemical;
    if (isChemical) {
      if (isNewInventory) {
        if (glasswareMaster) glasswareMaster.value = '';
        if (equipmentMaster) equipmentMaster.value = '';
        stockName.readOnly = false;
        itemType.disabled = false;
      }
      itemType.value = 'CONSUMABLE';
      if (unit.value === 'Piece') unit.value = 'Bottle';
      const validUnits = chemicalForm.value === 'LIQUID' ? ['ml', 'L'] : ['g', 'kg'];
      if (!validUnits.includes(capacityUnit.value)) {
        capacityUnit.value = chemicalForm.value === 'LIQUID' ? 'ml' : 'g';
      }
    }
    if (!isChemical && isNewInventory && syncInventoryMaster) {
      const selectedMaster = glasswareMaster?.value ? glasswareMaster : equipmentMaster;
      if (selectedMaster?.value) applyInventoryMasterChoice(selectedMaster);
      else {
        stockName.readOnly = false;
        itemType.disabled = false;
      }
    }
    updateInventoryMasterFields();
    if (!quantity.readOnly) {
      quantity.step = isChemical ? '1' : '0.001';
      quantity.min = isChemical ? '1' : '0.001';
    }
    Array.from(capacityUnit.options).forEach(option => {
      option.hidden = isChemical && (chemicalForm.value === 'LIQUID'
        ? !['ml', 'L'].includes(option.value)
        : !['g', 'kg'].includes(option.value));
    });
  }

  chemicalForm.addEventListener('change', updateChemicalFields);
  if (glasswareMaster) glasswareMaster.addEventListener('change', () => applyInventoryMasterChoice(glasswareMaster));
  if (equipmentMaster) equipmentMaster.addEventListener('change', () => applyInventoryMasterChoice(equipmentMaster));
  document.getElementById('calibration_required').addEventListener('change', updateCalibrationFrequencyVisibility);
  const savedBatch = document.getElementById('saved_batch');
  if (savedBatch) {
    const chemicalName = document.querySelector('[name="name"]');
    const batchNumber = document.getElementById('batch_number');
    const manufacturer = document.getElementById('manufacturer');
    const expiryDate = document.getElementById('expiry_date');
    savedBatch.addEventListener('change', () => {
      const option = savedBatch.selectedOptions[0];
      const reuseBatch = Boolean(option.dataset.batch);
      [chemicalName, batchNumber, manufacturer, expiryDate].forEach(input => {
        input.readOnly = reuseBatch;
      });
      if (!reuseBatch) {
        chemicalName.value = '';
        chemicalName.readOnly = false;
        chemicalForm.value = '';
        chemicalId.value = '';
        chemicalSearch.value = '';
        batchNumber.value = '';
        manufacturer.value = '';
        expiryDate.value = '';
        updateChemicalFields();
        return;
      }
      window.selectMasterOption('chemical_id', option.dataset.chemicalId);
      chemicalForm.value = option.dataset.form;
      batchNumber.value = option.dataset.batch;
      manufacturer.value = option.dataset.manufacturer;
      expiryDate.value = option.dataset.expiry;
      updateChemicalFields();
    });
  }
  updateInventoryMasterFields();
  updateChemicalFields();
</script>
