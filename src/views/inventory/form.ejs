<div class="page-head inventory-form-head">
  <div><div class="eyebrow">INVENTORY</div><h1><%= item?'Edit inventory':'Add inventory' %></h1><p class="muted"><%= item?'Update the inventory details below.':'Choose a category. On Chemical, select a type to unlock the form. Chemicals are tracked by batch and container size.' %></p></div>
  <a class="secondary button" href="/inventory">Back</a>
</div>
<section class="card form-card inventory-entry-form">
  <form method="post" action="<%= action %>" class="grid-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <% if(!item){ %>
      <div class="span-2 inventory-category-tabs" role="group" aria-label="Inventory category">
        <button type="button" class="active" aria-pressed="true" data-inventory-category="chemical">Chemical</button>
        <button type="button" aria-pressed="false" data-inventory-category="glassware">Glassware</button>
        <button type="button" aria-pressed="false" data-inventory-category="equipment">Equipment &amp; instruments</button>
      </div>
      <input type="hidden" id="name" name="name">
      <input type="hidden" id="item_type" name="item_type" value="ASSET">
    <% } else { %>
      <label id="stock_name_field" <%= item.chemical_form?'hidden':'' %>>Name *<input id="name" name="name" required maxlength="150" value="<%= item.chemical_form?'':item.name||'' %>" <%= item.chemical_form||item.glassware_master_id||item.equipment_master_id?'readonly':'' %>></label>
    <% } %>
    <% if(!item){ %>
      <div data-category-section="glassware" hidden>
        <%- include('../partials/master-autocomplete', {
          label: 'Glassware',
          fieldName: 'glassware_master_id',
          inputId: 'glassware_search',
          listId: 'glassware_options',
          options: glassware,
          selectedId: null,
          selectedName: null,
          disabledUntilChemicalType: false,
          initiallyHidden: false,
          required: false
        }) %>
      </div>
      <div data-category-section="equipment" hidden>
        <%- include('../partials/master-autocomplete', {
          label: 'Equipment & instruments',
          fieldName: 'equipment_master_id',
          inputId: 'equipment_search',
          listId: 'equipment_options',
          options: equipment,
          selectedId: null,
          selectedName: null,
          disabledUntilChemicalType: false,
          initiallyHidden: false,
          required: false
        }) %>
      </div>
    <% } else if(item.glassware_master_id){ %>
      <label>Glassware<input value="<%= item.glassware_master_name %>" readonly></label>
    <% } else if(item.equipment_master_id){ %>
      <label>Equipment & instruments<input value="<%= item.equipment_master_name %>" readonly></label>
    <% } %>
    <% if(item){ %>
      <label>Item type
        <select id="item_type" name="item_type" <%= item.glassware_master_id||item.equipment_master_id?'disabled':'' %>>
          <option value="ASSET" <%= item.item_type==='ASSET'?'selected':'' %>>Asset</option>
          <option value="CONSUMABLE" <%= item.item_type==='CONSUMABLE'?'selected':'' %>>Consumable</option>
        </select>
      </label>
    <% } %>
    <div class="span-2 chemical-selection-row" data-category-section="chemical" <%= item?'':'hidden' %>>
      <label class="chemical-type-field">Chemical type
        <select id="chemical_form" name="chemical_form" <%= item?.chemical_form?'disabled':'' %>>
          <option value=""><%= item?'Not a chemical':'Select type' %></option>
          <option value="LIQUID" <%= item?.chemical_form==='LIQUID'?'selected':'' %>>Liquid</option>
          <option value="POWDER" <%= item?.chemical_form==='POWDER'?'selected':'' %>>Powder</option>
        </select>
        <% if(item?.chemical_form){ %><input type="hidden" name="chemical_form" value="<%= item.chemical_form %>"><% } %>
      </label>
      <% if(!item){ %>
        <label class="chemical-create-toggle">
          <input id="create_new_chemical" type="checkbox"> Create a new chemical
        </label>
        <label id="new_chemical_name_field" hidden>New chemical name *<input id="chemical_name" name="chemical_name" maxlength="150"></label>
      <% } %>
      <%- include('../partials/master-autocomplete', {
        label: 'Chemical name',
        fieldName: 'chemical_id',
        inputId: 'chemical_search',
        listId: 'chemical_options',
        options: chemicals,
        selectedId: item?.chemical_master_id,
        selectedName: item?.chemical_master_name,
        disabledUntilChemicalType: true,
        initiallyHidden: Boolean(item && !item.chemical_form),
        required: Boolean(item?.chemical_form)
      }) %>
    </div>
    <% if(!item){ %><p id="chemical-type-warning" class="span-2 chemical-type-warning" role="alert" hidden>Please choose a chemical type.</p><% } %>
    <div id="chemical_fields" class="span-2 grid-form" <%= item?.chemical_form?'':'hidden' %>>
      <div class="chemical-capacity-row">
        <label>Qty received from vendor (packages) *
          <input id="package_count" type="number" step="1" min="1" name="package_count" value="<%= item?.package_count??'' %>" <%= item?'readonly':'' %>>
        </label>
        <label>Container capacity *
          <input type="number" step="0.001" min="0.001" name="container_capacity" value="<%= item?.container_capacity||'' %>">
        </label>
        <label>Capacity unit *
          <select name="container_unit">
            <% ['ml','L','mg','g','kg'].forEach(x=>{ %>
              <option value="<%= x %>" <%= (item?.container_unit||'ml')===x?'selected':'' %>><%= x %></option>
            <% }) %>
          </select>
        </label>
      </div>
      <p id="chemical-total-preview" class="span-2 muted"></p>
    </div>
    <div id="glassware_fields" class="span-2 grid-form" <%= item?.glassware_master_id?'':'hidden' %>>
      <label>Glassware type *<input name="glassware_type" maxlength="100" data-master-required value="<%= item?.glassware_type||'' %>"></label>
      <label>Capacity *<input type="number" step="0.001" min="0.001" max="999999999.999" name="capacity" data-master-required value="<%= item?.capacity||'' %>"></label>
      <label>Capacity unit *
        <select name="capacity_unit" data-master-required>
          <% ['ml','L','µl'].forEach(x=>{ %><option value="<%= x %>" <%= (item?.capacity_unit||'ml')===x?'selected':'' %>><%= x %></option><% }) %>
        </select>
      </label>
      <label>Material *<input name="material" maxlength="100" data-master-required value="<%= item?.material||'' %>"></label>
      <label>Class *
        <select name="glass_class" data-master-required>
          <% [['CLASS_A','Class A'],['CLASS_B','Class B'],['NOT_APPLICABLE','Not Applicable']].forEach(([value,label])=>{ %><option value="<%= value %>" <%= (item?.glass_class||'NOT_APPLICABLE')===value?'selected':'' %>><%= label %></option><% }) %>
        </select>
      </label>
      <label>Graduation *
        <select name="graduation" data-master-required>
          <% [['GRADUATED','Graduated'],['NON_GRADUATED','Non-graduated']].forEach(([value,label])=>{ %><option value="<%= value %>" <%= (item?.graduation||'NON_GRADUATED')===value?'selected':'' %>><%= label %></option><% }) %>
        </select>
      </label>
    </div>
    <div id="equipment_fields" class="span-2 grid-form" <%= item?.equipment_master_id?'':'hidden' %>>
      <label>Equipment type *<input name="equipment_type" maxlength="100" data-master-required value="<%= item?.equipment_type||'' %>"></label>
      <label>Model number<input name="model_number" maxlength="100" value="<%= item?.model_number||'' %>"></label>
      <label class="span-2">Technical specifications<textarea name="technical_specifications" maxlength="4000" rows="3"><%= item?.technical_specifications||'' %></textarea></label>
      <label>Calibration required *
        <select id="calibration_required" name="calibration_required" data-master-required>
          <option value="0" <%= String(item?.calibration_required??0)==='0'?'selected':'' %>>No</option>
          <option value="1" <%= String(item?.calibration_required??0)==='1'?'selected':'' %>>Yes</option>
        </select>
      </label>
      <label id="calibration_frequency_field" <%= String(item?.calibration_required||0)==='1'?'':'hidden' %>>Calibration frequency<input id="calibration_frequency" name="calibration_frequency" maxlength="100" value="<%= item?.calibration_frequency||'' %>" <%= String(item?.calibration_required||0)==='1'?'required':'' %>></label>
      <label>Warranty applicable *
        <select name="warranty_applicable" data-master-required>
          <option value="0" <%= String(item?.warranty_applicable??0)==='0'?'selected':'' %>>No</option>
          <option value="1" <%= String(item?.warranty_applicable??0)==='1'?'selected':'' %>>Yes</option>
        </select>
      </label>
    </div>
    <label id="quantity_field" data-chemical-type-required <%= item?.chemical_form?'hidden':'' %>><%= item?'Quantity':'Qty received from vendor' %> *<input id="quantity" type="number" step="0.001" min="0.001" name="quantity" required value="<%= item?.quantity??1 %>" <%= item?'readonly':'' %>></label>
    <label id="stock_unit_field" data-chemical-type-required <%= item?.chemical_form?'hidden':'' %>>Unit *<input id="unit" name="unit" maxlength="30" value="<%= item?.unit||'Piece' %>" required <%= item?'readonly':'' %>></label>
    <label id="chemical_unit_field" data-chemical-type-required <%= item?.chemical_form?'':'hidden' %>>Package unit *
      <select id="chemical_package_unit" name="packaging_type" required <%= item?'disabled':'' %>>
        <% const selectedPackaging=item?.packaging_type||item?.unit||'Bottle'; %>
        <% if(item?.chemical_form && !['Bottle','Box','Bag','Drum','Jar','Can','Tin','Pouch','Sachet','Packet','Vial','Ampoule','Tube','Carton','Case','Tray','Pack','Package','Kit','Set','Piece','Pair'].includes(selectedPackaging)){ %>
          <option value="<%= selectedPackaging %>" selected><%= selectedPackaging %> (existing record)</option>
        <% } %>
        <% ['Bottle','Box','Bag','Drum','Jar','Can','Tin','Pouch','Sachet','Packet','Vial','Ampoule','Tube','Carton','Case','Tray','Pack','Package','Kit','Set','Piece','Pair'].forEach(x=>{ %>
          <option value="<%= x %>" <%= selectedPackaging===x?'selected':'' %>><%= x %></option>
        <% }) %>
      </select>
      <% if(item){ %><input type="hidden" name="packaging_type" value="<%= item.packaging_type||item.unit %>"><% } %>
    </label>
    <%- include('../partials/master-autocomplete', {
      label: 'Vendor name',
      fieldName: 'vendor_id',
      inputId: 'vendor_search',
      listId: 'vendor_options',
      options: vendors,
      selectedId: item?.vendor_master_id,
      selectedName: item?.vendor_master_name,
      disabledUntilChemicalType: true,
      initiallyHidden: false,
      required: false
    }) %>
    <label data-chemical-type-required>Bill no.<input id="vendor_bill_no" name="vendor_bill_no" value="<%= item?.vendor_bill_no||'' %>"></label>
    <label data-chemical-type-required>Make / Grade<input id="make_grade" name="make_grade" value="<%= item?.make_grade||'' %>"></label>
    <div class="received-by-field" data-chemical-type-required>
      <label for="received_by_search">Received by</label>
      <div class="received-by-combobox" data-received-by>
        <input id="received_by_search" type="text" role="combobox" aria-autocomplete="list"
          aria-haspopup="listbox" aria-expanded="false" aria-controls="received_by_options"
          autocomplete="off" placeholder="Search inventory team" value="<%= item?.received_by||'' %>">
        <input id="received_by" type="hidden" name="received_by" value="<%= item?.received_by||'' %>">
        <button type="button" class="received-by-toggle" aria-label="Show inventory team members" aria-expanded="false"></button>
        <div id="received_by_options" class="master-autocomplete-list received-by-options" role="listbox" hidden>
          <% teamMembers.forEach((member,index)=>{ %>
            <button type="button" class="master-autocomplete-option received-by-option" role="option"
              id="received_by_option_<%= index %>" aria-selected="false"
              data-name="<%= member.name %>" data-code="<%= member.employee_code||'' %>">
              <span><%= member.name %></span>
              <small><%= member.employee_code||'' %></small>
            </button>
          <% }) %>
          <div class="master-autocomplete-empty received-by-empty" hidden>No matching team member.</div>
        </div>
      </div>
    </div>
    <label data-chemical-type-required>Date of receiving<input id="received_date" type="date" name="received_date" value="<%= item?.received_date||'' %>"></label>
    <label data-chemical-type-required>Batch number<input id="batch_number" name="batch_number" value="<%= item?.batch_number||'' %>"></label>
    <label data-chemical-type-required>Mfg. date<input id="manufacturer" type="date" name="manufacturer" value="<%= item?.manufacturer||'' %>"></label>
    <label data-chemical-type-required>Expiry date<input id="expiry_date" type="date" name="expiry_date" value="<%= item?.expiry_date||'' %>"></label>
    <label class="span-2" data-chemical-type-required>Description<textarea name="description" rows="3"><%= item?.description||'' %></textarea></label>
    <div class="span-2 form-actions" data-chemical-type-required><button class="primary">Save inventory</button><a class="secondary button" href="/inventory">Cancel</a></div>
  </form>
</section>
<% if(item&&user.permissions.includes('INVENTORY_UPDATE')&&item.status!=='RETIRED'){ %>
  <section class="card stock-maintenance-card">
    <div class="card-head"><div><div class="eyebrow">STOCK CONTROL</div><h2>Adjust or dispose of central stock</h2><p class="muted">Each change is recorded in the inventory transaction ledger.</p></div></div>
    <div class="stock-maintenance-grid">
      <form method="post" action="/inventory/<%= item.id %>/adjust" class="stack">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <h3>Adjust stock</h3>
        <label>Quantity change (+ or −)<input type="number" step="<%= item.chemical_form?'1':'0.001' %>" min="<%= item.chemical_form?'-'+item.quantity:'-'+item.quantity %>" name="delta" required placeholder="e.g. 2 or -1"></label>
        <label>Reason *<input name="note" maxlength="500" required></label>
        <button class="secondary">Record adjustment</button>
      </form>
      <form method="post" action="/inventory/<%= item.id %>/dispose" class="stack">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <h3>Dispose of stock</h3>
        <label>Quantity *<input type="number" step="<%= item.chemical_form?'1':'0.001' %>" min="<%= item.chemical_form?'1':'0.001' %>" max="<%= item.quantity %>" name="quantity" required></label>
        <label>Reason *<input name="note" maxlength="500" required></label>
        <button class="secondary danger">Record disposal</button>
      </form>
    </div>
  </section>
<% } %>
<script>
  const chemicalForm = document.getElementById('chemical_form');
  const chemicalFields = document.getElementById('chemical_fields');
  const quantityField = document.getElementById('quantity_field');
  const itemType = document.getElementById('item_type');
  const unit = document.getElementById('unit');
  const chemicalPackageUnit = document.getElementById('chemical_package_unit');
  const stockUnitField = document.getElementById('stock_unit_field');
  const chemicalUnitField = document.getElementById('chemical_unit_field');
  const capacityUnit = document.querySelector('[name="container_unit"]');
  const quantity = document.getElementById('quantity');
  const packageCount = document.getElementById('package_count');
  const chemicalSearch = document.getElementById('chemical_search');
  const chemicalId = document.getElementById('chemical_id');
  const chemicalNameControls = document.querySelectorAll('#chemical_search, #chemical_id, #chemical_options button');
  const stockNameField = document.getElementById('stock_name_field');
  const stockName = document.getElementById('name');
  const glasswareSearch = document.getElementById('glassware_search');
  const glasswareMaster = document.getElementById('glassware_master_id');
  const equipmentSearch = document.getElementById('equipment_search');
  const equipmentMaster = document.getElementById('equipment_master_id');
  const glasswareFields = document.getElementById('glassware_fields');
  const equipmentFields = document.getElementById('equipment_fields');
  const fixedGlasswareMaster = <%= Boolean(item?.glassware_master_id) %>;
  const fixedEquipmentMaster = <%= Boolean(item?.equipment_master_id) %>;
  const isNewInventory = <%= item?'false':'true' %>;
  const categoryTabs = Array.from(document.querySelectorAll('[data-inventory-category]'));
  const chemicalTypeDependentFields = Array.from(document.querySelectorAll('[data-chemical-type-required]'));
  const inventoryForm = document.querySelector('.inventory-entry-form form');
  const chemicalTypeWarning = document.getElementById('chemical-type-warning');
  const receivedByCombobox = document.querySelector('[data-received-by]');
  const createNewChemical = document.getElementById('create_new_chemical');
  const newChemicalNameField = document.getElementById('new_chemical_name_field');
  const newChemicalName = document.getElementById('chemical_name');
  let activeCategory = isNewInventory ? 'chemical' : null;

  function updateCalibrationFrequencyVisibility() {
    const required = !equipmentFields.hidden && document.getElementById('calibration_required').value === '1';
    const field = document.getElementById('calibration_frequency_field');
    const input = document.getElementById('calibration_frequency');
    field.hidden = !required;
    input.required = required;
    if (!required) input.value = '';
  }

  function updateChemicalTypeFormLock() {
    const locked = isNewInventory && activeCategory === 'chemical' && !chemicalForm.value;
    inventoryForm.dataset.chemicalTypeLocked = String(locked);
    chemicalTypeDependentFields.forEach(field => {
      field.querySelectorAll('input,select,textarea,button').forEach(control => {
        control.disabled = locked;
      });
    });
    unit.disabled = locked || (Boolean(chemicalForm.value) && isNewInventory);
    chemicalPackageUnit.disabled = locked || !chemicalForm.value || !isNewInventory;
    if (!locked && chemicalTypeWarning) chemicalTypeWarning.hidden = true;
  }

  inventoryForm.addEventListener('click', event => {
    if (
      inventoryForm.dataset.chemicalTypeLocked === 'true' &&
      event.target.closest('[data-chemical-type-required]')
    ) {
      chemicalTypeWarning.hidden = false;
    }
  });

  if (receivedByCombobox) {
    const input = receivedByCombobox.querySelector('#received_by_search');
    const selectedValue = receivedByCombobox.querySelector('#received_by');
    const toggle = receivedByCombobox.querySelector('.received-by-toggle');
    const list = receivedByCombobox.querySelector('[role="listbox"]');
    const options = Array.from(list.querySelectorAll('[role="option"]'));
    const empty = list.querySelector('.received-by-empty');
    let activeIndex = -1;
    let filterTimeout;

    function showOptions() {
      list.hidden = false;
      input.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-expanded', 'true');
    }

    function hideOptions() {
      list.hidden = true;
      input.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-expanded', 'false');
      input.removeAttribute('aria-activedescendant');
      activeIndex = -1;
    }

    function filterOptions() {
      const query = input.value.trim().toLocaleLowerCase();
      let visible = 0;
      options.forEach(option => {
        const matches = `${option.dataset.name} ${option.dataset.code}`.toLocaleLowerCase().includes(query);
        option.hidden = !matches;
        option.setAttribute('aria-selected', 'false');
        if (matches) visible += 1;
      });
      empty.hidden = visible > 0;
      activeIndex = -1;
    }

    function scheduleFilter() {
      window.clearTimeout(filterTimeout);
      filterTimeout = window.setTimeout(() => {
        filterTimeout = null;
        filterOptions();
        showOptions();
      }, 180);
    }

    function applyFilter() {
      window.clearTimeout(filterTimeout);
      filterTimeout = null;
      filterOptions();
    }

    function selectOption(option) {
      input.value = option.dataset.name;
      selectedValue.value = option.dataset.name;
      input.setCustomValidity('');
      hideOptions();
    }

    input.addEventListener('focus', () => {
      filterOptions();
      showOptions();
    });
    input.addEventListener('input', () => {
      selectedValue.value = '';
      input.setCustomValidity(input.value.trim() ? 'Choose a team member from the dropdown.' : '');
      scheduleFilter();
    });
    input.addEventListener('keydown', event => {
      if (filterTimeout) applyFilter();
      const visibleOptions = options.filter(option => !option.hidden);
      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
        event.preventDefault();
        showOptions();
        if (!visibleOptions.length) return;
        const direction = event.key === 'ArrowDown' ? 1 : -1;
        activeIndex = activeIndex < 0
          ? (direction > 0 ? 0 : visibleOptions.length - 1)
          : (activeIndex + direction + visibleOptions.length) % visibleOptions.length;
        visibleOptions.forEach((option, index) => option.setAttribute('aria-selected', String(index === activeIndex)));
        input.setAttribute('aria-activedescendant', visibleOptions[activeIndex].id);
        visibleOptions[activeIndex].scrollIntoView({ block: 'nearest' });
      } else if (event.key === 'Enter' && !list.hidden && activeIndex >= 0) {
        event.preventDefault();
        selectOption(visibleOptions[activeIndex]);
      } else if (event.key === 'Escape') {
        hideOptions();
      }
    });
    toggle.addEventListener('mousedown', event => event.preventDefault());
    toggle.addEventListener('click', () => {
      if (list.hidden) {
        filterOptions();
        input.focus();
        showOptions();
      } else {
        hideOptions();
      }
    });
    options.forEach(option => {
      option.addEventListener('mousedown', event => event.preventDefault());
      option.addEventListener('click', () => {
        applyFilter();
        if (!option.hidden) selectOption(option);
      });
    });
    input.addEventListener('blur', () => window.setTimeout(hideOptions, 100));
    document.addEventListener('click', event => {
      if (!receivedByCombobox.contains(event.target)) hideOptions();
    });
  }

  function updateInventoryMasterFields() {
    const hasGlasswareMaster = isNewInventory
      ? activeCategory === 'glassware' && Boolean(glasswareMaster?.value)
      : fixedGlasswareMaster;
    const hasEquipmentMaster = isNewInventory
      ? activeCategory === 'equipment' && Boolean(equipmentMaster?.value)
      : fixedEquipmentMaster;
    glasswareFields.hidden = !hasGlasswareMaster;
    equipmentFields.hidden = !hasEquipmentMaster;
    glasswareFields.querySelectorAll('[data-master-required]').forEach(input => {
      input.required = hasGlasswareMaster;
    });
    equipmentFields.querySelectorAll('[data-master-required]').forEach(input => {
      input.required = hasEquipmentMaster;
    });
    if (isNewInventory) {
      glasswareMaster.required = false;
      glasswareSearch.required = activeCategory === 'glassware';
      equipmentMaster.required = false;
      equipmentSearch.required = activeCategory === 'equipment';
      glasswareMaster.disabled = activeCategory !== 'glassware';
      equipmentMaster.disabled = activeCategory !== 'equipment';
    }
    glasswareFields.querySelectorAll('input,select,textarea').forEach(input => {
      input.disabled = !hasGlasswareMaster;
    });
    equipmentFields.querySelectorAll('input,select,textarea').forEach(input => {
      input.disabled = !hasEquipmentMaster;
    });
    updateCalibrationFrequencyVisibility();
  }

  function selectInventoryCategory(category) {
    if (!isNewInventory) return;
    activeCategory = category;
    categoryTabs.forEach(tab => {
      const selected = tab.dataset.inventoryCategory === category;
      tab.classList.toggle('active', selected);
      tab.setAttribute('aria-pressed', String(selected));
    });
    document.querySelectorAll('[data-category-section]').forEach(section => {
      section.hidden = section.dataset.categorySection !== category;
    });
    if (category !== 'chemical') chemicalForm.value = '';
    if (category !== 'glassware') {
      glasswareMaster.value = '';
      if (glasswareSearch) {
        glasswareSearch.value = '';
        glasswareSearch.setCustomValidity('');
      }
    }
    if (category !== 'equipment') {
      equipmentMaster.value = '';
      if (equipmentSearch) {
        equipmentSearch.value = '';
        equipmentSearch.setCustomValidity('');
      }
    }
    stockName.value = '';
    stockName.readOnly = false;
    stockName.disabled = false;
    itemType.value = category === 'chemical' ? 'CONSUMABLE' : 'ASSET';
    itemType.disabled = false;
    chemicalForm.required = category === 'chemical';
    chemicalForm.disabled = category !== 'chemical';
    updateChemicalFields(false);
  }

  document.querySelectorAll('[data-master-combobox]').forEach(combobox => {
    const input = combobox.querySelector('[data-master-input]');
    const idInput = combobox.querySelector('input[type="hidden"]');
    const list = combobox.querySelector('[role="listbox"]');
    const options = Array.from(list.querySelectorAll('[role="option"]'));
    const empty = list.querySelector('.master-autocomplete-empty');
    let activeIndex = -1;

    function showOptions() {
      list.hidden = false;
      input.setAttribute('aria-expanded', 'true');
    }

    function hideOptions() {
      list.hidden = true;
      input.setAttribute('aria-expanded', 'false');
      input.removeAttribute('aria-activedescendant');
      activeIndex = -1;
    }

    function filterOptions() {
      const query = input.value.trim().toLocaleLowerCase();
      let visible = 0;
      options.forEach(option => {
        const matches = option.dataset.name.toLocaleLowerCase().startsWith(query);
        option.hidden = !matches;
        option.setAttribute('aria-selected', 'false');
        if (matches) visible += 1;
      });
      empty.hidden = visible > 0;
      activeIndex = -1;
    }

    function selectOption(option) {
      input.value = option.dataset.name;
      idInput.value = option.dataset.value;
      input.setCustomValidity('');
      hideOptions();
      input.dispatchEvent(new Event('master-selection', { bubbles: true }));
    }

    input.addEventListener('focus', () => {
      filterOptions();
      showOptions();
    });
    input.addEventListener('input', () => {
      idInput.value = '';
      input.setCustomValidity(input.value.trim() ? 'Select an existing option from the list.' : '');
      filterOptions();
      showOptions();
    });
    input.addEventListener('keydown', event => {
      const visibleOptions = options.filter(option => !option.hidden);
      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
        event.preventDefault();
        showOptions();
        if (!visibleOptions.length) return;
        const direction = event.key === 'ArrowDown' ? 1 : -1;
        activeIndex = activeIndex < 0
          ? (direction > 0 ? 0 : visibleOptions.length - 1)
          : (activeIndex + direction + visibleOptions.length) % visibleOptions.length;
        visibleOptions.forEach((option, index) => option.setAttribute('aria-selected', String(index === activeIndex)));
        if (visibleOptions[activeIndex]) input.setAttribute('aria-activedescendant', visibleOptions[activeIndex].id);
        if (visibleOptions[activeIndex]) visibleOptions[activeIndex].scrollIntoView({ block: 'nearest' });
      } else if (event.key === 'Enter' && !list.hidden) {
        const option = visibleOptions[activeIndex];
        if (option) {
          event.preventDefault();
          selectOption(option);
        }
      } else if (event.key === 'Escape') {
        hideOptions();
      }
    });
    options.forEach(option => {
      option.addEventListener('mousedown', event => event.preventDefault());
      option.addEventListener('click', () => selectOption(option));
    });
    document.addEventListener('click', event => {
      if (!combobox.contains(event.target)) hideOptions();
    });
    input.addEventListener('blur', () => {
      window.setTimeout(hideOptions, 100);
    });
    input.addEventListener('master-selection', () => {
      if (input.value.trim() && !idInput.value) input.setCustomValidity('Select an existing option from the list.');
      else input.setCustomValidity('');
    });
    filterOptions();
  });

  window.selectMasterOption = (fieldName, id) => {
    const masterInput = Array.from(document.querySelectorAll('[data-master-input]'))
      .find(input => input.dataset.masterInput === fieldName);
    const combobox = masterInput?.closest('[data-master-combobox]');
    if (!combobox) return;
    const option = Array.from(combobox.querySelectorAll('[role="option"]'))
      .find(candidate => candidate.dataset.value === String(id));
    if (option) option.click();
  };

  function applyInventoryMasterChoice(select) {
    if (!isNewInventory || !select) return;
    const other = select === glasswareMaster ? equipmentMaster : glasswareMaster;
    if (select.value) {
      if (other) other.value = '';
      chemicalForm.value = '';
      updateChemicalFields(false);
      stockName.value = select === glasswareMaster
        ? glasswareSearch.value
        : equipmentSearch.value;
      stockName.readOnly = true;
      itemType.value = 'ASSET';
      itemType.disabled = true;
    } else if (other && other.value) {
      applyInventoryMasterChoice(other);
    } else {
      stockName.readOnly = false;
      itemType.disabled = false;
    }
    updateInventoryMasterFields();
  }

  function updateChemicalTotalPreview() {
    const preview = document.getElementById('chemical-total-preview');
    if (!preview) return;
    const count = Number(packageCount?.value || 0);
    const capacity = Number(document.querySelector('[name="container_capacity"]')?.value || 0);
    const unitValue = capacityUnit?.value || '';
    preview.textContent = count > 0 && capacity > 0
      ? `Live total: ${Number((count * capacity).toFixed(6)).toLocaleString()} ${unitValue}`
      : '';
  }

  function updateChemicalFields(syncInventoryMaster = true) {
    const isChemical = Boolean(chemicalForm.value);
    chemicalFields.hidden = !isChemical || (isNewInventory && activeCategory !== 'chemical');
    quantityField.hidden = isChemical;
    quantity.required = !isChemical;
    chemicalFields.querySelectorAll('input,select,textarea').forEach(input => {
      input.disabled = !isChemical || (isNewInventory && activeCategory !== 'chemical');
    });
    if (stockNameField) stockNameField.hidden = isChemical;
    stockName.disabled = isChemical;
    stockUnitField.hidden = isChemical;
    chemicalUnitField.hidden = !isChemical;
    unit.required = !isChemical;
    chemicalPackageUnit.required = isChemical;
    chemicalSearch.required = isChemical;
    if (!isChemical) {
      chemicalId.value = '';
      chemicalSearch.value = '';
      chemicalSearch.setCustomValidity('');
    }
    document.querySelector('[name="container_capacity"]').required = isChemical;
    capacityUnit.required = isChemical;
    document.getElementById('batch_number').required = isChemical;
    document.getElementById('expiry_date').required = isChemical;
    if (isChemical) {
      if (isNewInventory) {
        if (glasswareMaster) glasswareMaster.value = '';
        if (glasswareSearch) {
          glasswareSearch.value = '';
          glasswareSearch.setCustomValidity('');
        }
        if (equipmentMaster) equipmentMaster.value = '';
        if (equipmentSearch) {
          equipmentSearch.value = '';
          equipmentSearch.setCustomValidity('');
        }
        stockName.readOnly = false;
        itemType.disabled = false;
      }
      itemType.value = 'CONSUMABLE';
      if (unit.value === 'Piece') unit.value = 'Bottle';
      chemicalPackageUnit.value = unit.value;
      unit.value = chemicalPackageUnit.value;
      const validUnits = chemicalForm.value === 'LIQUID' ? ['ml', 'L'] : ['mg', 'g', 'kg'];
      if (!validUnits.includes(capacityUnit.value)) {
        capacityUnit.value = chemicalForm.value === 'LIQUID' ? 'ml' : 'g';
      }
      if (packageCount) packageCount.required = isNewInventory;
      updateChemicalTotalPreview();
    } else if (packageCount) {
      packageCount.required = false;
    }
    if (!isChemical && isNewInventory && syncInventoryMaster) {
      const selectedMaster = glasswareMaster?.value ? glasswareMaster : equipmentMaster;
      if (selectedMaster?.value) applyInventoryMasterChoice(selectedMaster);
      else {
        stockName.readOnly = false;
        itemType.disabled = false;
      }
    }
    updateInventoryMasterFields();
    if (!quantity.readOnly) {
      quantity.step = isChemical ? '1' : '0.001';
      quantity.min = isChemical ? '1' : '0.001';
    }
    Array.from(capacityUnit.options).forEach(option => {
      option.hidden = isChemical && (chemicalForm.value === 'LIQUID'
        ? !['ml', 'L'].includes(option.value)
        : !['mg', 'g', 'kg'].includes(option.value));
    });
    updateChemicalTypeFormLock();
    const chemicalNameDisabled = !isChemical || (isNewInventory && activeCategory !== 'chemical');
    chemicalNameControls.forEach(control => {
      control.disabled = chemicalNameDisabled;
    });
  }

  function updateNewChemicalMode() {
    if (!createNewChemical) return;
    const creating = createNewChemical.checked;
    newChemicalNameField.hidden = !creating;
    newChemicalName.required = creating;
    const autocomplete = chemicalSearch?.closest('[data-master-combobox]');
    if (autocomplete) autocomplete.hidden = creating;
    if (creating) {
      chemicalId.value = '';
      chemicalSearch.value = '';
      chemicalSearch.required = false;
    } else {
      chemicalSearch.required = Boolean(chemicalForm.value);
    }
  }
  createNewChemical?.addEventListener('change', updateNewChemicalMode);
  chemicalForm.addEventListener('change', () => {
    updateChemicalFields();
    updateNewChemicalMode();
  });
  if (packageCount) packageCount.addEventListener('input', updateChemicalTotalPreview);
  capacityUnit?.addEventListener('change', updateChemicalTotalPreview);
  document.querySelector('[name="container_capacity"]')?.addEventListener('input', updateChemicalTotalPreview);
  chemicalPackageUnit.addEventListener('change', () => {
    unit.value = chemicalPackageUnit.value;
  });
  categoryTabs.forEach(tab => {
    tab.addEventListener('click', () => selectInventoryCategory(tab.dataset.inventoryCategory));
  });
  if (glasswareSearch) {
    glasswareSearch.addEventListener('master-selection', () => applyInventoryMasterChoice(glasswareMaster));
    glasswareSearch.addEventListener('input', () => {
      glasswareMaster.value = '';
      applyInventoryMasterChoice(glasswareMaster);
    });
  }
  if (equipmentSearch) {
    equipmentSearch.addEventListener('master-selection', () => applyInventoryMasterChoice(equipmentMaster));
    equipmentSearch.addEventListener('input', () => {
      equipmentMaster.value = '';
      applyInventoryMasterChoice(equipmentMaster);
    });
  }
  document.getElementById('calibration_required').addEventListener('change', updateCalibrationFrequencyVisibility);
  if (categoryTabs.length) selectInventoryCategory(activeCategory);
  updateInventoryMasterFields();
  updateChemicalFields();
  updateNewChemicalMode();
</script>
