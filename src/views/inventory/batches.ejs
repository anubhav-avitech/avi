<div class="page-head">
  <div>
    <div class="eyebrow">INVENTORY DOCUMENTS</div>
    <h1>Batch receiving records</h1>
    <p class="muted">Each record groups all chemicals that share a batch number within a department.</p>
  </div>
  <a class="secondary button" href="/inventory">Back to inventory</a>
</div>
<section class="card batch-record-list">
  <% if(!batches.length){ %>
    <div class="empty">No chemical batches with batch numbers have been entered yet.</div>
  <% }else{ %>
    <% batches.forEach(batch=>{ %>
      <article class="batch-record-card">
        <div>
          <div class="eyebrow"><%= batch.department %></div>
          <h2>Batch <%= batch.batch_number %></h2>
          <p class="muted"><%= batch.chemical_count %> chemicals · <%= batch.line_count %> stock lines<% if(batch.bill_count){ %> · <%= batch.bill_count %> vendor bills<% } %></p>
          <% if(batch.first_received_date){ %><small class="muted">First received <%= batch.first_received_date %></small><% } %>
        </div>
        <a class="primary button" href="/inventory/batches/receiving-record?department_id=<%= batch.department_id %>&batch_number=<%= encodeURIComponent(batch.batch_number) %>">Open batch record</a>
      </article>
    <% }) %>
  <% } %>
</section>
