<div class="page-head inventory-page-head">
  <div>
    <div class="eyebrow">INVENTORY</div>
    <h1>Stock register</h1>
    <p class="muted">Review stock, receiving details, batch information and availability.</p>
  </div>
</div>
<form class="toolbar" method="get">
  <input name="q" value="<%= query %>" placeholder="Search item, batch, vendor or reference…">
  <button class="secondary">Search</button>
  <% if(user.permissions.includes('INVENTORY_CREATE')){ %>
    <a class="primary button" href="/inventory/new">Add item</a>
  <% } %>
</form>
<section class="card inventory-table-card">
  <table class="inventory-table">
    <thead><tr><th>Item and details</th><th>Type</th><th>Stock balance</th><th>Status</th><th class="actions-heading">Actions</th></tr></thead>
    <tbody>
      <% if(!items.length){ %><tr><td colspan="5" class="empty">No inventory found.</td></tr><% } %>
      <% items.forEach(i=>{ %>
        <% const today=new Date(); today.setHours(0,0,0,0); const daysToExpiry=i.expiry_date?Math.ceil((new Date(`${i.expiry_date}T00:00:00`)-today)/86400000):null; %>
        <tr>
          <td class="inventory-item">
            <strong><%= i.name %></strong>
            <div class="item-subdetails">
              <span class="item-reference"><%= i.asset_code %></span>
              <% if(i.serial_number){ %><span>Serial: <%= i.serial_number %></span><% } %>
            </div>
            <% if(i.glassware_master_id){ %>
              <details class="purchase-details">
                <summary>Glassware details</summary>
                <dl>
                  <div><dt>Type</dt><dd><%= i.glassware_type || '—' %></dd></div>
                  <div><dt>Capacity</dt><dd><%= i.capacity||'—' %> <%= i.capacity_unit||'' %></dd></div>
                  <div><dt>Material</dt><dd><%= i.material||'—' %></dd></div>
                  <div><dt>Class</dt><dd><%= i.glass_class||'—' %></dd></div>
                  <div><dt>Graduation</dt><dd><%= i.graduation||'—' %></dd></div>
                </dl>
              </details>
            <% } else if(i.equipment_master_id){ %>
              <details class="purchase-details">
                <summary>Equipment details</summary>
                <dl>
                  <div><dt>Type</dt><dd><%= i.equipment_type||'—' %></dd></div>
                  <div><dt>Mfg. date</dt><dd><%= i.manufacturer||'—' %></dd></div>
                  <div><dt>Model</dt><dd><%= i.model_number||'—' %></dd></div>
                  <div><dt>Specifications</dt><dd><%= i.technical_specifications||'—' %></dd></div>
                  <div><dt>Calibration</dt><dd><%= i.calibration_required?'Required':'Not required' %><%= i.calibration_frequency?` · ${i.calibration_frequency}`:'' %></dd></div>
                  <div><dt>Warranty</dt><dd><%= i.warranty_applicable?'Applicable':'Not applicable' %></dd></div>
                </dl>
              </details>
            <% } %>
            <% if(i.chemical_form){ %>
              <div class="chemical-summary">
                <span><%= i.chemical_form.toLowerCase() %></span>
                <span>Batch <%= i.batch_number || '—' %></span>
                <span>Expires <%= i.expiry_date || '—' %></span>
              </div>
              <details class="purchase-details">
                <summary>Receiving and purchase details</summary>
                <dl>
                  <div><dt>Vendor</dt><dd><%= i.vendor_name || '—' %></dd></div>
                  <div><dt>Bill no.</dt><dd><%= i.vendor_bill_no || '—' %></dd></div>
                  <div><dt>Make / grade</dt><dd><%= i.make_grade || '—' %></dd></div>
                  <div><dt>Mfg. date</dt><dd><%= i.manufacturer || '—' %></dd></div>
                  <div><dt>Received</dt><dd><%= i.received_date || '—' %></dd></div>
                  <div><dt>Received by</dt><dd><%= i.received_by || '—' %></dd></div>
                </dl>
              </details>
            <% } %>
            <% if(Number(i.minimum_stock)>0&&Number(i.product_available_quantity)<=Number(i.minimum_stock)){ %><span class="tag low-stock-tag">LOW STOCK · product available <%= i.product_available_quantity %> <%= i.unit %></span><% } %>
            <% if(i.chemical_form&&daysToExpiry!==null&&daysToExpiry<0){ %><span class="tag">EXPIRED</span><% }else if(i.chemical_form&&daysToExpiry!==null&&daysToExpiry<=30){ %><span class="tag"><%= daysToExpiry===0?'EXPIRES TODAY':`EXPIRING IN ${daysToExpiry} DAYS` %></span><% } %>
          </td>
          <td><span class="tag"><%= i.chemical_form?'CHEMICAL':i.glassware_master_id?'GLASSWARE':i.equipment_master_id?'EQUIPMENT':i.item_type %></span></td>
          <td>
            <div class="stock-balance"><strong><%= i.quantity %> <%= i.unit %></strong><span>Available</span></div>
            <% if(i.chemical_form){ %><small><%= i.container_capacity %> <%= i.container_unit %> per container · <%= Number(i.quantity*i.container_capacity).toLocaleString() %> <%= i.container_unit %> total</small><% } %>
          </td>
          <td><span class="status <%= i.status.toLowerCase() %>"><%= i.status %></span></td>
          <td class="actions">
            <% if(user.role_name==='Administrator'&&user.permissions.includes('AUDIT_VIEW')){ %><a href="/inventory/<%= i.id %>/history">History</a><% } %>
            <% if(user.permissions.includes('INVENTORY_CREATE')&&i.status!=='RETIRED'){ %><a href="/inventory/<%= i.id %>/restock">Add stock</a><% } %>
            <% if(user.permissions.includes('INVENTORY_UPDATE')&&i.status!=='RETIRED'){ %><a href="/inventory/<%= i.id %>/edit">Edit</a><% } %>
            <% if(user.permissions.includes('INVENTORY_DELETE')&&i.status!=='RETIRED'){ %>
              <form method="post" action="/inventory/<%= i.id %>/retire" data-item-name="<%= i.name %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="link danger">Retire</button></form>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</section>
<dialog class="retire-dialog" id="retire_dialog" aria-labelledby="retire_dialog_title">
  <form method="dialog">
    <div class="eyebrow">CONFIRM RETIREMENT</div>
    <h2 id="retire_dialog_title">Retire inventory item?</h2>
    <p class="muted">Type <strong>retire</strong> to confirm retiring <span id="retire_item_name"></span>.</p>
    <label for="retire_confirmation">Confirmation<input id="retire_confirmation" autocomplete="off" placeholder="Type retire"></label>
    <div class="retire-dialog-actions">
      <button class="secondary" type="button" id="cancel_retire">Cancel</button>
      <button class="primary retire-confirm-button" type="button" id="confirm_retire" disabled>Retire item</button>
    </div>
  </form>
</dialog>
<script>
  const retireDialog = document.getElementById('retire_dialog');
  const retireInput = document.getElementById('retire_confirmation');
  const confirmRetireButton = document.getElementById('confirm_retire');
  const retireItemName = document.getElementById('retire_item_name');
  let pendingRetireForm = null;
  let confirmedRetirement = false;

  document.querySelectorAll('form[action$="/retire"]').forEach(form => {
    form.addEventListener('submit', event => {
      if (confirmedRetirement) {
        confirmedRetirement = false;
        return;
      }
      event.preventDefault();
      pendingRetireForm = form;
      retireItemName.textContent = form.dataset.itemName;
      retireInput.value = '';
      confirmRetireButton.disabled = true;
      retireDialog.showModal();
      retireInput.focus();
    });
  });

  retireInput.addEventListener('input', () => {
    confirmRetireButton.disabled = retireInput.value.trim().toLowerCase() !== 'retire';
  });

  document.getElementById('cancel_retire').addEventListener('click', () => retireDialog.close());
  retireDialog.addEventListener('close', () => {
    pendingRetireForm = null;
  });

  confirmRetireButton.addEventListener('click', () => {
    if (!pendingRetireForm || retireInput.value.trim().toLowerCase() !== 'retire') return;
    const form = pendingRetireForm;
    pendingRetireForm = null;
    retireDialog.close();
    confirmedRetirement = true;
    form.requestSubmit();
  });
</script>
