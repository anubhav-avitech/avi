<div class="page-head"><div><div class="eyebrow">ISSUE STOCK</div><h1>Assign inventory</h1></div><div class="form-actions"><a class="secondary button" href="/employees/new">Add person</a><a class="secondary button" href="/assignments">Back</a></div></div><section class="card form-card"><form method="post" action="/assignments/new" class="stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Inventory *<select name="inventory_id" required><option value="">Select inventory</option><% items.forEach(i=>{ %><option value="<%= i.id %>"><%= i.asset_code %> · <%= i.name %> — <%= i.quantity %> <%= i.unit %> · <%= i.department %></option><% }) %></select></label><label>Employee *<select name="employee_id" required><option value="">Select employee</option><% employees.forEach(employee=>{ %><option value="<%= employee.id %>"><%= employee.employee_code %> · <%= employee.name %></option><% }) %></select></label><label>Quantity *<input type="number" step="0.001" min="0.001" name="quantity" value="1" required></label><button class="primary">Confirm assignment</button></form></section>
