<div class="page-head"><div><h1>Dashboard</h1></div></div><section class="stats"><div class="stat"><small>Records</small><strong><%= data.summary.total||0 %></strong></div><div class="stat"><small>Total quantity</small><strong><%= data.summary.quantity||0 %></strong></div><div class="stat"><small>Available</small><strong><%= data.summary.available||0 %></strong></div><div class="stat"><small>Assigned</small><strong><%= data.summary.assigned||0 %></strong></div><div class="stat"><small>Maintenance</small><strong><%= data.summary.maintenance||0 %></strong></div></section><section class="card"><div class="card-head"><div><h2>Department stock</h2></div></div><table><thead><tr><th>Department</th><th>Records</th><th>Quantity</th></tr></thead><tbody><% data.departments.forEach(d=>{ %><tr><td><%= d.name %></td><td><%= d.items %></td><td><%= d.quantity %></td></tr><% }) %></tbody></table></section>
