<div class="page-head"><div><div class="eyebrow">HISTORY</div><h1><%= item ? item.name : 'Inventory history' %></h1><p class="muted"><%= item ? item.asset_code+' · '+item.department : 'Inventory transactions within your permitted scope.' %></p></div><a class="secondary button" href="/inventory">Inventory</a></div>
<section class="card"><table><thead><tr><th>Date</th><th>Item</th><th>Action</th><th>Quantity</th><th>User</th><th>Actor</th><th>Details</th></tr></thead><tbody>
<% if(!rows.length){ %><tr><td colspan="7" class="empty">No transactions found.</td></tr><% } %>
<% rows.forEach(r=>{ %><tr><td><%= r.created_at %></td><td><strong><%= r.item_name %></strong><small><%= r.asset_code %> · <%= r.department %></small></td><td><span class="tag"><%= r.action %></span></td><td><%= r.quantity||'—' %> <%= r.unit||'' %></td><td><%= r.affected_user||'—' %></td><td><%= r.actor_name %></td><td><code><%= r.details||'—' %></code></td></tr><% }) %></tbody></table></section>
