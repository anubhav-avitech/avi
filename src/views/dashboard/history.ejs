<%
function historyDetails(details, unit) {
  let value = details;
  if (typeof value === 'string') {
    try {
      value = JSON.parse(value);
    } catch (error) {
      return [{ label: 'Details', value }];
    }
  }
  if (!value || typeof value !== 'object' || Array.isArray(value)) {
    return value == null ? [] : [{ label: 'Details', value: String(value) }];
  }

  const labels = {
    asset_code: 'Asset code',
    batch_number: 'Batch',
    expiry_date: 'Expiry date',
    balance_after: 'Remaining balance',
    chemical_form: 'Form',
    container_capacity: 'Container size',
    container_unit: 'Container unit',
    previous_status: 'Previous status',
    note: 'Note',
    full_return: 'Full return'
  };
  const entries = [];
  const displayValue = (entry, key) => {
    if (entry == null || entry === '') return '—';
    if (typeof entry === 'boolean') return entry ? 'Yes' : 'No';
    if (key === 'balance_after' && unit) return `${entry} ${unit}`;
    if (typeof entry === 'object') return 'Updated';
    return String(entry);
  };

  if (value.before && value.after && typeof value.before === 'object' && typeof value.after === 'object') {
    const keys = new Set([...Object.keys(value.before), ...Object.keys(value.after)]);
    for (const key of keys) {
      if (JSON.stringify(value.before[key]) !== JSON.stringify(value.after[key])) {
        entries.push({
          label: labels[key] || key.replace(/_/g, ' '),
          value: `${displayValue(value.before[key], key)} → ${displayValue(value.after[key], key)}`
        });
      }
    }
    return entries;
  }

  for (const [key, entry] of Object.entries(value)) {
    if (key === 'restock' || key === 'assignment_id') continue;
    entries.push({
      label: labels[key] || key.replace(/_/g, ' '),
      value: displayValue(entry, key)
    });
  }
  return entries;
}
%>
<div class="toolbar history-search">
  <input id="history_search" type="search" placeholder="Search history by item, batch, action, user…" aria-label="Search transaction history">
</div>
<p id="history_search_status" class="history-search-status" aria-live="polite" hidden></p>
<section class="card"><table><thead><tr><th>Date</th><th>Item</th><th>Action</th><th>Quantity</th><th>User</th><th>Actor</th><th>Details</th></tr></thead><tbody id="history_rows">
<% if(!rows.length){ %><tr><td colspan="7" class="empty">No transactions found.</td></tr><% } %>
<% rows.forEach(r=>{ const details=historyDetails(r.details,r.unit); %><tr class="history-row"><td><%= r.created_at %></td><td><strong><%= r.item_name %></strong><small><%= r.asset_code %> · <%= r.department %></small></td><td><span class="tag"><%= r.action %></span></td><td><%= r.quantity||'—' %> <%= r.unit||'' %></td><td><%= r.affected_user||'—' %></td><td><%= r.actor_name %></td><td class="history-details"><% if(details.length){ %><dl><% details.forEach(detail=>{ %><div><dt><%= detail.label %></dt><dd><%= detail.value %></dd></div><% }) %></dl><% }else{ %>—<% } %></td></tr><% }) %></tbody></table></section>
<script>
  const historySearch = document.getElementById('history_search');
  const historyRows = [...document.querySelectorAll('.history-row')];
  const historySearchStatus = document.getElementById('history_search_status');

  historySearch.addEventListener('input', () => {
    const query = historySearch.value.trim().toLocaleLowerCase();
    let visibleRows = 0;

    historyRows.forEach(row => {
      const matches = row.textContent.toLocaleLowerCase().includes(query);
      row.hidden = !matches;
      if (matches) visibleRows += 1;
    });

    historySearchStatus.hidden = !query;
    if (query) {
      historySearchStatus.textContent = visibleRows
        ? `${visibleRows} matching transaction${visibleRows === 1 ? '' : 's'}`
        : 'No matching transactions.';
    }
  });
</script>
