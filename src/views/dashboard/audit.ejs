<div class="page-head"><div><div class="eyebrow">TRACEABILITY</div><h1>Audit log</h1><p class="muted">Recent security and inventory activity.</p></div></div><section class="card"><table><thead><tr><th>Time</th><th>Actor</th><th>Action</th><th>Entity</th><th>Details</th></tr></thead><tbody><% rows.forEach(r=>{ %><tr><td><%= r.created_at %></td><td><%= r.actor_name||'System' %></td><td><span class="tag"><%= r.action %></span></td><td><%= r.entity_type %> #<%= r.entity_id||'—' %></td><td><code><%= r.details||'—' %></code></td></tr><% }) %></tbody></table></section>
