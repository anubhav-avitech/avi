<header class="topbar">
  <a class="brand" href="/" aria-label="Avitech Nutrition inventory home"><img class="brand-logo" src="/logo.png" alt="Avitech Nutrition"></a>
  <nav>
    <a class="<%= path==='/'?'active':'' %>" href="/">Overview</a>
    <% if((user.permissions || []).includes('INVENTORY_VIEW')){ %>
      <a class="<%= path.startsWith('/inventory')&&!path.startsWith('/inventory/batches')?'active':'' %>" href="/inventory">Inventory</a>
      <a class="<%= path.startsWith('/inventory/batches')?'active':'' %>" href="/inventory/batches">Batch receiving records</a>
    <% } %>
    <% if((user.role_name==='Inventory User'||user.role_name==='Administrator')&&(user.permissions.includes('ASSIGNMENT_CREATE')||user.permissions.includes('ASSIGNMENT_RETURN')||user.permissions.includes('ASSIGNMENT_CONSUME'))){ %>
      <a class="<%= path.startsWith('/assignments')?'active':'' %>" href="/assignments">Assignments</a>
    <% } %>
    <% if(user.role_name==='Administrator'){ %>
      <a class="<%= path==='/master/chemicals'||path.startsWith('/master/chemicals/')?'active':'' %>" href="/master/chemicals">Chemical master</a>
      <a class="<%= path==='/master/vendors'||path.startsWith('/master/vendors/')?'active':'' %>" href="/master/vendors">Vendor master</a>
      <a class="<%= path.startsWith('/purchase-orders')?'active':'' %>" href="/purchase-orders">Purchase orders</a>
      <% if(user.permissions.includes('USERS_VIEW')){ %><a class="<%= path.startsWith('/users')?'active':'' %>" href="/users">Inventory Team</a><% } %>
      <% if(user.permissions.includes('AUDIT_VIEW')){ %><a class="<%= path==='/activity-history'?'active':'' %>" href="/activity-history">Activity &amp; History</a><% } %>
    <% } %>
  </nav>
  <div class="profile">
    <%- include('theme-toggle', { themeToggleClass: '' }) %>
    <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="ghost">Sign out</button></form>
  </div>
</header>
