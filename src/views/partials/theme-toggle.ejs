<button class="theme-toggle <%= themeToggleClass %>" type="button" role="switch" aria-checked="false" aria-label="Night theme" title="Switch to night theme">
  <span class="theme-toggle-track" aria-hidden="true">
    <span class="theme-toggle-sun">☀</span>
    <span class="theme-toggle-moon">☾</span>
    <span class="theme-toggle-thumb"></span>
  </span>
</button>
